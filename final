function updateAssignGrpInfo(tn,type){
  const el=document.getElementById('asgn-grp-info');if(!el)return;
  if(type==='single'){el.innerHTML='';return;}
  const tc=G&&G.tc||15;
  const{start,end,size,groupId}=sheetRange(tn,type);
  const clampEnd=Math.min(end,tc);
  if(clampEnd-start+1<size){
    el.innerHTML='<span style="color:var(--red);">Only '+(clampEnd-start+1)+' ticket(s) left in this range not enough for a '+(type==='half'?'half':'full')+' sheet. Pick a different type.</span>';
    return;
  }
  const nums=[];for(let i=start;i<=clampEnd;i++)nums.push(p3(i));
  const conflicts=[];
  for(let i=start;i<=clampEnd;i++){
    const ot=G&&G.tickets&&G.tickets[i];
    if(ot&&ot.name&&i!==tn&&ot.groupId!==groupId)conflicts.push(p3(i)+' ('+ot.name+')');
  }
  let html='Tickets <b>'+nums.join(', ')+'</b> will all be assigned together.';
  if(conflicts.length)html+='<br><span style="color:var(--red);">Already booked: '+conflicts.join(', ')+' saving will overwrite them.</span>';
  el.innerHTML=html;
}
function saveAdmBkTix(tn){
