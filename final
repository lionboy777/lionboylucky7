[data-light] .tc.h{background:#FFFEF2;color:#2E1A8E;}
[data-light] .tc.e{background:#F2EFDD;}
[data-light] .tc.m{background:var(--g2)!important;color:#fff!important;}
[data-light] .cdu{background:var(--g5);border-color:var(--brd2);}
[data-light] .cdn{color:#0D1220;}
[data-light] .status-pill{background:#fff;}
[data-light] .m-item{color:#2E3A55;}
[data-light] .m-lbl{color:#8899BB;}
[data-light] .m-theme span{color:#2E3A55;}
