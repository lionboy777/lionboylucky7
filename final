function stopAudio(){
  try{if(_aA){_aA.pause();_aA=null;}}catch(e){}
  try{if(_aB){_aB.pause();_aB=null;}}catch(e){}
  L.audioLock=false;
}
/* Start: start_sound.mp3 → after 2s overlap start.mp3 → when start.mp3 ends → cb */
function playStart(cb){
  stopAudio();
  _aA=_play(AUDIO_BASE+'start_sound.mp3',null);
  setTimeout(()=>{
    _aB=_play(AUDIO_BASE+'start.mp3',()=>{
      try{if(_aA)_aA.pause();}catch(e){}
      _aA=null;_aB=null;if(cb)cb();
    });
  },2000);
}
/* Number: play mp3 → silent gap → cb. Lock prevents any overlap. */
function playNum(n,cb){
  // Don't recursively wait if locked, caller manages the wait
  L.audioLock=true;
  _aB=_play(AUDIO_BASE+n+'.mp3',()=>{
    _aB=null;
    // 1.5s gap after audio ends before releasing lock
    setTimeout(()=>{L.audioLock=false;if(cb)cb();},1500);
  });
}
/* Winner: winner_sound.mp3 → after 1.5s overlap winner.mp3 */
function playWin(){
  stopAudio();
  _aA=_play(AUDIO_BASE+'winner_sound.mp3',null);
  setTimeout(()=>{
    _aB=_play(AUDIO_BASE+'winner.mp3',()=>{
      try{if(_aA)_aA.pause();}catch(e){}
      _aA=null;_aB=null;
    });
  },1500);
}

