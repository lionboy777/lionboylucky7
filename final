<script>
/* ════ CONSTANTS ════ */
const AUDIO_BASE='https://lionboy777.github.io/ll7-audio/';

/* Welcome popup plays welcome.mp3, unlocks browser audio for entire session */
function acceptWelcome(){
  const ov=document.getElementById('welcome-ov');
  if(ov)ov.style.display='none';
  // Mark as accepted so it doesn't show again this session
  sessionStorage.setItem('ll7_accepted','1');
  L.audioUnlocked=true;
  // Play welcome.mp3 this tap also unlocks browser autoplay for the session
  const a=new Audio(AUDIO_BASE+'welcome.mp3');
  a.play().catch(()=>{});
  // FIX: the loading screen (z-index 9999) sits *under* this popup
  // (z-index 10000). If Firebase already resolved while the popup was
  // covering the screen, startListeners() already called hideLoading()
  // and this is a no-op fine. But we must NOT force-hide loading here
  // if Firebase hasn't responded yet, or a genuine connection failure
  // gets silently masked instead of showing the 10s error message.
  // Only nudge it if data has actually arrived.
  if(typeof G!=='undefined'&&G&&typeof hideLoading==='function')hideLoading();
}

/* Play book.mp3 when site loads and tickets are available for booking */
function playBookSound(){
  if(!L.audioUnlocked)return;
  const a=new Audio(AUDIO_BASE+'book.mp3');
  a.play().catch(()=>{});
}

// If already accepted this session (e.g. page refresh), skip popup
if(sessionStorage.getItem('ll7_accepted')==='1'){
  const ov=document.getElementById('welcome-ov');
  if(ov)ov.style.display='none';
  L.audioUnlocked=true;
}
const SEC_KEY='FREEMONEY69';
const MODES=[
  {id:'early5',name:'Early 5',desc:'First 5 numbers crossed'},
  {id:'topline',name:'Top Line',desc:'All 5 in top row'},
  {id:'midline',name:'Middle Line',desc:'All 5 in middle row'},
  {id:'botline',name:'Bottom Line',desc:'All 5 in bottom row'},
  {id:'corners',name:'Corners',desc:'First & last of top & bottom (4 nums)'},
  {id:'sixcorners',name:'6 Corners',desc:'First & last of all 3 rows (6 nums)'},
  {id:'pyramid',name:'Pyramid',desc:'3rd top, 2nd&4th mid, 1st,3rd,5th bot'},
  {id:'plus',name:'Plus Sign',desc:'Middle row + middle column'},
  {id:'diamond',name:'Diamond',desc:'3rd of 1st&3rd row, 1st&last of mid'},
  {id:'fullhouse',name:'Full House',desc:'All 15 numbers MAIN PRIZE'},
  {id:'fullsheetbonus',name:'Full Sheet Bonus',desc:'First full-sheet booking (6 tickets) where EVERY ticket has ≥2 numbers marked. Sheet bookings only.'},
  {id:'halfsheetbonus',name:'Half Sheet Bonus',desc:'First half-sheet booking (3 tickets) where EVERY ticket has ≥2 numbers marked. Sheet bookings only.'}
];
const DC=['','#F4C430','#6C47FF','#FF4757','#00C896','#FF6B35','#B44FFF','#FF3D71','#4FACFE','#00C896'];

/* ════ STATE ════ */
let G=null;            // current PAID game (from Firebase, path 'game')
let GF=null;           // current FREE game (from Firebase, path 'gameFree')
let L={                // local only state
  isAdmin:false,
  theme:'light',
  banners:['','','','',''],
  selectedBanner:-1,
  searched:{live:[],dash:[],home:[],freegame:[]},
  audioLock:false,
  audioOk:true,
  audioUnlocked:false,
  muted:(localStorage.getItem('ll7_muted')==='1'),
  bookSoundPlayed:false,
  calling:false,
  callTmr:null,
  elTmr:null,
  lastWinCount:0,
  lastWinCountF:0,
  lastAdminCalled:null,
  lastShown:null,
};
let _aA=null,_aB=null; // audio tracks

/* ════ AUDIO STRICT SEQUENTIAL ════ */
// L.audioUnlocked: becomes true after one successful play() triggered by a
// real user gesture. Mobile browsers block autoplay until this happens once
// per page session. We no longer treat a single failure as fatal forever  
// audioOk resets per-attempt so a transient/network failure on one number
// doesn't silence the rest of the game.
function unlockAudio(){
  if(L.audioUnlocked||L.muted)return;
  try{
    const a=new Audio(AUDIO_BASE+'start_sound.mp3');
    a.volume=0;
    const p=a.play();
    if(p&&p.then){
      p.then(()=>{L.audioUnlocked=true;a.pause();a.currentTime=0;}).catch(()=>{});
    }else{
      L.audioUnlocked=true;
    }
  }catch(e){}
}
function _play(url,onEnd){
  // If muted, skip real playback but still resolve the callback at roughly
  // the same pace, so the calling loop's timing/pauses stay identical
  // whether sound is on or off muting must never speed up or break calling.
  if(L.muted){
    setTimeout(()=>{if(onEnd)onEnd();},1200);
    return null;
  }
  const a=new Audio(url);
  a.onended=()=>{L.audioOk=true;if(onEnd)onEnd();};
  a.onerror=()=>{
    L.audioOk=false;
    showAudioWarning();
    setTimeout(()=>{if(onEnd)onEnd();},2500);
  };
  a.play().then(()=>{L.audioOk=true;L.audioUnlocked=true;}).catch(()=>{
    // Per-attempt failure only does NOT permanently disable audio for
    // the rest of the game. Most common cause: this play() wasn't
    // triggered inside/close enough to a user gesture (autoplay block).
    L.audioOk=false;
    showAudioWarning();
    setTimeout(()=>{if(onEnd)onEnd();},2500);
  });
