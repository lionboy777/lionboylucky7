  --w:#12141C;--bg:#0A0B10;--bg2:#111219;
  --card:rgba(255,255,255,0.045);--card2:rgba(255,255,255,0.07);
  --t:#EDEFF6;--t2:#9BA0B4;--t3:#6B7086;--t4:#3A3E4E;
  --brd:rgba(255,255,255,0.08);--brd2:rgba(255,255,255,0.14);
  --sh:0 2px 20px rgba(0,0,0,0.35);--sh2:0 8px 32px rgba(0,0,0,0.4);--sh3:0 20px 64px rgba(0,0,0,0.5);
  --red:#E5637A;--red2:rgba(229,99,122,0.14);
  --d1:#C9A24C;--d2:#6E62E8;--d3:#E5637A;--d4:#4FBF9A;--d5:#D68A5C;--d6:#9A6FE0;--d7:#E0668F;--d8:#5CA6D6;--d9:#4FBF9A;
