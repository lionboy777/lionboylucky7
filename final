  const paid=document.getElementById('asgn-paid').value==='true';
  const bookType=document.getElementById('asgn-type').value;
  if(bookType==='single'){
    db.ref('game/tickets/'+tn).update({name:n,paid,bookType:'single',groupId:null}).then(()=>{
      closeModal();toast('Ticket #'+p3(tn)+' assigned to '+n);
      if(document.getElementById('adm-bk-chart'))renderAdmBookings();
    });
    return;
  }
  const tc=G.tc||15;
