.pg.on{display:block;}

/* HERO */
.hero-section{
  position:relative;
  padding:44px 20px 54px;text-align:center;overflow:hidden;
}
.hero-section::after{
  content:'';position:absolute;bottom:-1px;left:0;right:0;height:40px;
  background:var(--bg);clip-path:ellipse(55% 100% at 50% 100%);
}
.hero-eyebrow{
  font-family:var(--font-num);font-size:.62rem;letter-spacing:3px;
  color:var(--t3);font-weight:600;margin-bottom:10px;position:relative;z-index:1;
}
.hero-title{
  font-family:var(--font-head);font-size:1.7rem;font-weight:600;
  color:var(--t);margin-bottom:2px;position:relative;z-index:1;
  letter-spacing:.2px;white-space:nowrap;
}
.hero-sub{
  font-size:.6rem;letter-spacing:3px;color:var(--t3);
  font-weight:600;position:relative;z-index:1;
}
.status-pill-wrap{
  display:flex;justify-content:center;
  margin-top:24px;position:relative;z-index:2;padding:0 20px;
}
.status-pill{
  display:inline-flex;align-items:center;gap:9px;
  background:var(--card);backdrop-filter:blur(var(--blur));-webkit-backdrop-filter:blur(var(--blur));
  border-radius:14px;
  padding:13px 24px;box-shadow:var(--sh2);
  font-weight:600;font-size:.88rem;color:var(--t);
  border:1px solid var(--brd2);
  transition:all .18s;
}
.status-pill.clickable{cursor:pointer;}
.status-pill.clickable:active{transform:scale(.97);}
.status-pill.is-live{border-color:rgba(229,99,122,.4);box-shadow:0 0 0 1px rgba(229,99,122,.15),var(--sh2);}
.status-pill.is-booking{border-color:rgba(110,98,232,.4);box-shadow:0 0 0 1px rgba(110,98,232,.15),var(--sh2);}
.sp-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
.sp-dot.live{background:var(--red);animation:bl 1s infinite;}
.sp-dot.coming{background:var(--t4);}
.sp-dot.booking{background:var(--g3);}
.sp-dot.sold{background:var(--d5);}

/* COMING SOON STATE */
.coming-soon-wrap{
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:36px 24px 20px;text-align:center;
}
.cs-sub{font-size:.82rem;color:var(--t3);line-height:1.6;max-width:280px;}

/* NOTICES */
.notices-wrap{padding:12px 14px 0;}
.notice-card{background:var(--gold3);border:1px solid rgba(201,162,76,0.3);border-radius:var(--r2);padding:12px 14px;position:relative;margin-bottom:10px;}
.notice-txt{font-size:.86rem;line-height:1.6;color:var(--t2);}
.notice-time{font-size:.64rem;color:var(--t3);margin-top:4px;}
.soc-row{display:flex;gap:10px;flex-wrap:wrap;padding:10px 14px 0;}
.soc-wa{background:#25D366;color:#fff;border:none;border-radius:12px;padding:9px 18px;font-weight:600;font-size:.82rem;display:flex;align-items:center;gap:6px;text-decoration:none;}
.soc-ig{background:linear-gradient(135deg,#833ab4,#c1387a);color:#fff;border:none;border-radius:12px;padding:9px 18px;font-weight:600;font-size:.82rem;display:flex;align-items:center;gap:6px;text-decoration:none;}
.soc-tg{background:#229ED9;color:#fff;border:none;border-radius:12px;padding:9px 18px;font-weight:600;font-size:.82rem;display:flex;align-items:center;gap:6px;text-decoration:none;}
.soc-call{background:var(--g2);color:#fff;border:none;border-radius:12px;padding:9px 18px;font-weight:600;font-size:.82rem;display:flex;align-items:center;gap:6px;text-decoration:none;}
.soc-call .soc-call-name{opacity:.85;font-weight:500;}

/* GAME INFO PANEL (replaces old illustrated prize banner) */
.prize-banner{
  margin:16px 14px 0;
  background:var(--card);backdrop-filter:blur(var(--blur));-webkit-backdrop-filter:blur(var(--blur));
  border:1px solid var(--brd);
  border-radius:var(--r2);overflow:hidden;
  box-shadow:var(--sh);
}
.pb-header{
  padding:15px 16px 12px;
  display:flex;align-items:center;justify-content:space-between;
  border-bottom:1px solid var(--brd);
}
.pb-title{font-family:var(--font-head);font-size:1.02rem;font-weight:600;color:var(--t);}
.pb-pool{font-family:var(--font-num);font-size:1.05rem;font-weight:600;color:var(--gold);}
.pb-body{padding:14px 16px 16px;}
.pb-meta{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;}
.pb-tag{background:var(--g5);border:1px solid var(--brd2);color:var(--g3);border-radius:8px;padding:4px 11px;font-size:.7rem;font-weight:600;}
.pb-tag.paid{background:var(--gold3);border-color:rgba(201,162,76,0.3);color:var(--gold);}
.pb-tag.live{background:var(--red2);border-color:rgba(229,99,122,.3);color:var(--red);}
.pb-desc{font-size:.85rem;color:var(--t2);margin-bottom:12px;line-height:1.5;}
.pb-prizes{display:flex;flex-direction:column;gap:6px;margin-bottom:12px;}
.pb-prize-row{
  display:flex;align-items:center;justify-content:space-between;
  padding:9px 12px;
  background:var(--card2);
  border:1px solid var(--brd);
  border-radius:var(--r);
}
.pb-prize-row:first-child{
  background:var(--gold3);
  border-color:rgba(201,162,76,0.25);
}
.pbp-mode{font-size:.8rem;font-weight:600;color:var(--t2);}
.pbp-amt{font-family:var(--font-num);font-size:.92rem;font-weight:600;color:var(--gold);}
.pb-info{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px;}
.pb-info-cell{background:var(--card2);border:1px solid var(--brd);border-radius:var(--r);padding:10px 12px;text-align:center;}
.pb-info-val{font-family:var(--font-num);font-size:1.05rem;font-weight:600;color:var(--g3);}
.pb-info-lbl{font-size:.6rem;letter-spacing:.3px;color:var(--t3);font-weight:500;margin-top:2px;}
/* About Us page */
.ab-sec{padding:18px 16px;border-bottom:1px solid var(--brd);}
.ab-h{font-family:var(--font-head);font-size:.98rem;font-weight:800;color:var(--t);margin-bottom:10px;display:flex;align-items:center;gap:8px;}
.ab-p{font-size:.84rem;color:var(--t2);line-height:1.65;margin-bottom:8px;}
.ab-ol{margin:0 0 4px;padding-left:20px;font-size:.84rem;color:var(--t2);line-height:2;}
.ab-ul{margin:0 0 4px;padding-left:4px;font-size:.84rem;color:var(--t2);line-height:2;list-style:none;}
.ab-ul li{position:relative;padding-left:22px;}
.ab-ul li::before{content:'✓';position:absolute;left:2px;color:#00C896;font-weight:800;}
.ab-note{font-size:.78rem;color:var(--t3);margin-top:8px;line-height:1.5;}
.ab-inline-link{background:none;border:none;color:var(--g3);font-weight:700;font-size:inherit;cursor:pointer;text-decoration:underline;text-underline-offset:2px;padding:0;font-family:inherit;}
.ab-live-dot{font-size:.56rem;font-weight:800;color:#00C896;background:rgba(0,200,150,0.15);padding:3px 9px;border-radius:8px;letter-spacing:.5px;animation:bl 1.6s infinite;}
.ab-stats-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;}
.ab-soon{font-size:.68rem;color:var(--t4);font-style:italic;}
.ab-faq{background:var(--card);border:1px solid var(--brd);border-radius:var(--r);padding:12px 14px;margin-bottom:8px;}
.ab-faq summary{font-size:.85rem;font-weight:700;color:var(--t);cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:10px;}
.ab-faq summary::-webkit-details-marker{display:none;}
.ab-faq summary::after{content:'+';font-size:1.2rem;color:var(--t3);font-weight:400;flex-shrink:0;}
.ab-faq[open] summary::after{content:'−';}
.ab-faq p{font-size:.8rem;color:var(--t2);line-height:1.6;margin-top:10px;padding-top:10px;border-top:1px solid var(--brd);}
.pb-banner-img{width:100%;height:140px;object-fit:cover;display:none;border-bottom:1px solid var(--brd);}
.live-now-badge{display:inline-flex;align-items:center;gap:6px;background:var(--red);color:#fff;border-radius:20px;padding:7px 16px;font-weight:800;font-size:.78rem;cursor:pointer;box-shadow:0 2px 12px rgba(255,71,87,0.35);}

/* COUNTDOWN */
.cd-wrap{display:flex;gap:8px;justify-content:center;padding:4px 0 2px;}
.free-nav-badge{color:var(--red);font-weight:800;font-size:1.05rem;letter-spacing:1.5px;animation:bl 1.4s infinite;}
.cd-overdue{width:100%;text-align:center;padding:10px 8px;font-size:.86rem;font-weight:800;color:var(--red);animation:bl 1.2s infinite;}
.overdue-alert{background:var(--red2);border:1.5px dashed rgba(255,71,87,.4);border-radius:var(--r);padding:12px 14px;margin-bottom:12px;font-size:.82rem;font-weight:700;color:var(--red);cursor:pointer;animation:bl 1.6s infinite;}
.flip-group{display:flex;gap:4px;}
.flip-digit{
  width:46px;height:64px;
  background:linear-gradient(180deg,#6C8A98 0%,#5C7A8A 48%,#4A6270 52%,#3E5460 100%);
  border-radius:6px;
  display:flex;align-items:center;justify-content:center;
  font-family:var(--font-num);font-size:2rem;font-weight:600;color:#fff;
  position:relative;box-shadow:0 4px 10px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.15);
  transition:transform .15s ease;transform-origin:center;
}
.flip-digit::before{
  content:'';position:absolute;top:50%;left:3px;right:3px;height:2px;background:rgba(0,0,0,.4);transform:translateY(-50%);z-index:2;
}
.flip-digit.flip{transform:scaleY(.08);}

/* SEC HEADING */
.sec-hd{font-family:var(--font-head);font-size:.62rem;font-weight:800;letter-spacing:2.5px;color:var(--t4);text-transform:uppercase;padding:16px 14px 8px;display:flex;align-items:center;gap:8px;}
.sec-hd::after{content:'';flex:1;height:1px;background:var(--brd);}

/* TICKET OVERVIEW GRID 6 per row */
.tov-grid-wrap{padding:0 14px 8px;}
.tov-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:6px;}
.tov{
  aspect-ratio:1;display:flex;flex-direction:column;align-items:center;justify-content:center;
  border-radius:8px;border:1px solid var(--brd);font-size:.65rem;font-weight:800;
  background:var(--card);color:var(--t3);transition:all .2s;
}
.tov.open{border-style:dashed;}
.tov.booked{
  background:rgba(108,71,255,0.18);
  border-color:var(--g2);border-style:solid;
  color:var(--g3);
}
.tov.booked .tov-icon{color:var(--gold);}

/* TICKET CHART GRID Seat map style */
.tix-chart-section{padding:0 14px 16px;}
.tix-chart-section .board-ttl{margin-bottom:12px;}
.tix-chart{display:grid;gap:5px;}
.tch{
  aspect-ratio:1;display:flex;flex-direction:column;align-items:center;justify-content:center;
  border-radius:8px;border:1px solid var(--brd);font-size:.68rem;font-weight:800;
  background:var(--card);color:var(--t3);transition:all .25s cubic-bezier(.34,1.56,.64,1);cursor:default;
}
.tch.booked{
  background:linear-gradient(135deg,var(--g2),var(--g));
  border-color:var(--g2);color:#fff;
  box-shadow:0 2px 10px rgba(108,71,255,.35);
  transform:scale(1.04);
}
.tch.open{border-style:dashed;opacity:.6;}
.tch .tn{font-size:.7rem;font-weight:800;line-height:1;}
.tch .tl{font-size:.44rem;font-weight:700;margin-top:2px;opacity:.75;}

/* ════ AUTHENTIC TAMBOLA TICKET ════ */
.tix-list{padding:0 14px 24px;display:flex;flex-direction:column;gap:16px;}

/* Outer card wrapper */
.tcard{
  background:var(--card);backdrop-filter:blur(var(--blur));-webkit-backdrop-filter:blur(var(--blur));
  border-radius:14px;
  overflow:hidden;
  box-shadow:var(--sh);
  border:1px solid var(--brd);
  position:relative;
  transition:box-shadow .2s;
}
.tcard.booked{border-color:rgba(110,98,232,0.35);}
.tcard.open{opacity:.6;}
.tcard.highlighted{
  border-color:var(--gold);border-width:1.5px;
  box-shadow:0 0 0 3px rgba(201,162,76,.14),var(--sh);
}

/* Punch-hole notches */
.tcard::before,.tcard::after{
  content:'';position:absolute;width:14px;height:14px;border-radius:50%;
  background:var(--bg);border:1px solid var(--brd);z-index:2;
  top:50%;transform:translateY(-50%);
}
.tcard::before{left:-7px;}
.tcard::after{right:-7px;}

/* Ticket top band */
.tc-band{
  height:38px;
  display:flex;align-items:center;justify-content:space-between;
  padding:0 18px 0 16px;
  background:var(--g5);border-bottom:1px solid var(--brd);
}
.tcard.open .tc-band{background:var(--card2);}
.tc-num{
  font-size:.86rem;font-weight:600;
  color:var(--g3);letter-spacing:.2px;
}
.tcard.open .tc-num{color:var(--t3);}
.tc-tag{
  font-size:.62rem;font-weight:600;letter-spacing:.3px;
  padding:3px 10px;border-radius:20px;
  background:var(--card2);color:var(--t2);border:1px solid var(--brd2);
}

/* Buyer name bar */
.tc-buyer{
  display:flex;align-items:center;justify-content:space-between;
  padding:8px 14px;
  background:var(--card2);
  border-bottom:1px dashed var(--brd2);
}
.tc-name{font-size:.8rem;font-weight:600;color:var(--t);}
.tc-paid{
  display:inline-flex;align-items:center;gap:3px;
  font-size:.62rem;font-weight:600;padding:2px 9px;border-radius:8px;
}
.tc-paid.p{background:rgba(79,191,154,0.15);color:#4FBF9A;}
.tc-paid.u{background:var(--red2);color:var(--red);}

/* THE ACTUAL TAMBOLA TICKET GRID */
.tc-body{
  background:rgba(255,255,255,0.02);
  padding:10px 12px 12px;
  position:relative;
}
[data-light] .tc-body{background:#FFFDF6;}

.tc-body::before{
  content:'';display:block;
  border-top:1px dashed var(--brd2);
  margin-bottom:8px;
}

.ticket-tbl{
  width:100%;border-collapse:collapse;
  border:1.5px solid var(--brd2);
  border-radius:4px;overflow:hidden;
}
[data-light] .ticket-tbl{border-color:#DDD3B8;}

.ticket-tbl tr{border-bottom:1px solid var(--brd);}
[data-light] .ticket-tbl tr{border-bottom-color:#DDD3B8;}
.ticket-tbl tr:last-child{border-bottom:none;}

.ticket-tbl td{
  border-right:1px solid var(--brd);
  width:11.11%;padding:0;text-align:center;position:relative;
}
[data-light] .ticket-tbl td{border-right-color:#DDD3B8;}
.ticket-tbl td:last-child{border-right:none;}

/* Each cell */
.tc{
  display:flex;align-items:center;justify-content:center;
  height:32px;font-family:var(--font-num);font-size:.84rem;font-weight:600;
  position:relative;overflow:hidden;
  transition:background .18s,color .18s;
}

/* Empty cell */
.tc.e{background:rgba(255,255,255,0.02);color:transparent;}
[data-light] .tc.e{background:#F1ECD9;}
.tc.e::before{
  content:'';position:absolute;inset:3px;
  border:1px dashed var(--brd2);border-radius:2px;
}

/* Number cell */
.tc.h{background:transparent;color:var(--g4);}
[data-light] .tc.h{background:#FFFDF6;color:#3A2E7A;}

/* Marked / daubed */
.tc.m{background:var(--g2)!important;color:#fff!important;}
.tc.m::after{
  content:'';position:absolute;inset:0;
  background:radial-gradient(circle,rgba(255,255,255,.15) 0%,transparent 65%);
}
.tc.daub{animation:daub .28s cubic-bezier(.34,1.56,.64,1);}
@keyframes daub{0%{transform:scale(1.35);}50%{transform:scale(.93);}100%{transform:scale(1);}}

/* LIVE PAGE */
.live-top{
  padding:28px 16px 40px;position:relative;overflow:hidden;
}
.live-top::after{
  content:'';position:absolute;bottom:-1px;left:0;right:0;height:36px;
  background:var(--bg);clip-path:ellipse(60% 100% at 50% 100%);
}
.lt-dots{display:none;}
.lt-circle{display:none;}
.lt-circle2{display:none;}
.lt-label{
  font-size:.62rem;font-weight:600;letter-spacing:2.5px;
  color:var(--t3);margin-bottom:8px;text-align:center;
}
.lt-num{
  font-family:var(--font-num);
  font-size:clamp(6.5rem,26vw,9rem);
  font-weight:600;color:var(--t);line-height:1;
  text-align:center;
  letter-spacing:-2px;
  position:relative;z-index:1;
}
.lt-num.pop{animation:numpop .38s cubic-bezier(.34,1.56,.64,1);}
@keyframes numpop{0%{transform:scale(.65);opacity:.3;}100%{transform:scale(1);opacity:1;}}
.lt-call{
  font-size:.8rem;font-weight:500;
  color:var(--t3);font-style:italic;
  text-align:center;margin-top:4px;
  min-height:1.3em;padding:0 20px;letter-spacing:.2px;
}
.lt-prev{
  display:flex;align-items:center;justify-content:center;gap:6px;
  margin-top:12px;flex-wrap:wrap;
}
.lt-prev-label{font-size:.6rem;font-weight:600;letter-spacing:1.5px;color:var(--t3);}
.lt-prev-nums{display:flex;gap:5px;flex-wrap:wrap;justify-content:center;}
.lt-prev-n{
  background:var(--g5);color:var(--g3);
  border-radius:8px;padding:3px 9px;
  font-family:var(--font-num);font-size:.72rem;font-weight:600;
  border:1px solid var(--brd2);
}

.stat-strip{
  display:grid;grid-template-columns:repeat(4,1fr);
  background:var(--card);
  border-bottom:1px solid var(--brd);
}
.ss{padding:12px 4px;text-align:center;border-right:1px solid var(--brd);}
.ss:last-child{border-right:none;}
.ss-v{font-family:var(--font-head);font-size:1.2rem;font-weight:800;color:var(--g3);}
.ss-l{font-size:.48rem;letter-spacing:1.5px;color:var(--t3);font-weight:700;margin-top:2px;text-transform:uppercase;}
.act-bar{
  display:flex;align-items:center;justify-content:space-between;
  padding:10px 14px;background:var(--card);border-bottom:1px solid var(--brd);
}
.shr-btn{
  background:var(--g5);color:var(--g3);border:1px solid var(--brd2);
  border-radius:20px;padding:7px 16px;font-size:.78rem;font-weight:700;
  display:flex;align-items:center;gap:5px;transition:all .15s;
}
.shr-btn:active{transform:scale(.95);}
.vc-badge{
  display:none;align-items:center;gap:5px;
  background:var(--g6);border:1px solid var(--brd);
  border-radius:20px;padding:5px 12px;font-size:.74rem;font-weight:700;color:var(--g3);
}
.vc-badge.on{display:flex;}
.vcdot{width:7px;height:7px;background:var(--g3);border-radius:50%;animation:bl 1.5s infinite;}

/* BOARD */
.board-section{padding:14px 12px;}
.board-ttl{
  font-family:var(--font-head);font-size:.6rem;font-weight:800;
  letter-spacing:2.5px;color:var(--t3);text-transform:uppercase;
  margin-bottom:10px;display:flex;align-items:center;gap:8px;
}
.board-ttl::after{content:'';flex:1;height:1px;background:var(--brd);}
.board-grid{display:grid;grid-template-columns:repeat(10,1fr);gap:4px;}
.bc{
  aspect-ratio:1;display:flex;align-items:center;justify-content:center;
  border-radius:7px;font-weight:800;font-size:clamp(.56rem,2.2vw,.78rem);
  color:#fff;opacity:.18;transition:all .22s;
}
.bc.on{opacity:1;transform:scale(1.06);box-shadow:0 2px 10px rgba(0,0,0,.4);}
.bc.fresh{animation:bcf .38s cubic-bezier(.34,1.56,.64,1);}
@keyframes bcf{0%{transform:scale(1.8);opacity:.6;}100%{transform:scale(1.06);opacity:1;}}

/* WINNERS */
.win-card{
  background:var(--card);border:1px solid var(--brd);border-radius:var(--r2);
  padding:12px 14px;display:flex;align-items:center;gap:10px;
  margin-bottom:8px;border-left:3px solid var(--gold);
  animation:wein .35s cubic-bezier(.34,1.56,.64,1);
}
@keyframes wein{from{transform:translateX(16px);opacity:0;}to{transform:translateX(0);opacity:1;}}
.win-ic{font-size:1.4rem;}
.win-tp{font-weight:800;color:var(--gold);font-size:.86rem;}
.win-dt{font-size:.72rem;color:var(--t3);margin-top:2px;}

/* MULTI-SEARCH */
.msearch-wrap{padding:10px 14px 0;}
.msearch-box{
  display:flex;gap:8px;align-items:center;
  background:var(--card);border:1px solid var(--brd2);
  border-radius:var(--r2);padding:10px 14px;
}
.msearch-box input{flex:1;border:none;background:none;font-size:.88rem;font-weight:600;color:var(--t);outline:none;}
.msearch-box input::placeholder{color:var(--t4);}
.msearch-box button{
  background:var(--g2);color:#fff;border:none;
  border-radius:var(--r);padding:8px 16px;font-weight:700;font-size:.8rem;
  white-space:nowrap;transition:opacity .15s;
}
.msearch-box button:active{opacity:.8;}
.msearch-results{margin-top:10px;}
.msearch-wrap2{position:relative;margin-bottom:14px;}
.msearch-remove{
  position:absolute;top:8px;right:8px;z-index:10;
  background:var(--red);color:#fff;border:none;
  border-radius:50%;width:26px;height:26px;font-size:.72rem;
  display:flex;align-items:center;justify-content:center;cursor:pointer;font-weight:800;
}

/* UPCOMING */
.ev-wrap{padding:0 14px 20px;}
.ev-card{background:var(--card);border:1px solid var(--brd);border-radius:var(--r2);padding:16px;margin-bottom:12px;}
.ev-name{font-family:var(--font-head);font-weight:800;font-size:.94rem;margin-bottom:10px;}
.ev-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px;}
.ev-cell{background:var(--bg2);border-radius:var(--r);padding:8px 10px;border:1px solid var(--brd);}
.ev-cv{font-size:.88rem;font-weight:700;color:var(--g3);}
.ev-cl{font-size:.56rem;letter-spacing:1px;color:var(--t3);font-weight:700;text-transform:uppercase;}
.ev-cd{display:flex;gap:6px;margin-top:10px;}
.ev-cdu{background:var(--g2);color:#fff;border-radius:8px;padding:6px 10px;text-align:center;flex:1;}
.ev-cdn{font-family:var(--font-head);font-size:1.1rem;font-weight:800;line-height:1;}
.ev-cdl{font-size:.44rem;letter-spacing:1.5px;font-weight:700;opacity:.8;text-transform:uppercase;}

/* PREV */
.prev-card{background:var(--card);border:1px solid var(--brd);border-radius:var(--r2);padding:14px 16px;margin-bottom:10px;display:flex;align-items:center;justify-content:space-between;gap:10px;}
.prev-nm{font-family:var(--font-head);font-weight:800;font-size:.9rem;margin-bottom:4px;}
.prev-mt{font-size:.74rem;color:var(--t3);}
.pw-card{background:var(--card);border:1px solid var(--brd);border-radius:var(--r2);padding:14px 16px;margin-bottom:10px;}
.pw-gn{font-family:var(--font-head);font-weight:800;font-size:.88rem;margin-bottom:8px;padding-bottom:6px;border-bottom:1px solid var(--brd);}
.pw-row{display:flex;align-items:center;gap:8px;padding:4px 0;font-size:.8rem;}
.pw-md{font-weight:700;color:var(--g3);min-width:100px;}
.pw-dt{color:var(--t3);flex:1;}
.pw-prize{font-weight:800;color:var(--gold);font-size:.8rem;}

/* ADMIN */
.adm-pg{display:none;padding-top:60px;min-height:100vh;}
.adm-pg.on{display:block;}
.adm-wrap{padding:0 14px 28px;}
.ap{display:none;}.ap.on{display:block;}
.pt{font-family:var(--font-head);font-size:1.1rem;font-weight:800;color:var(--g3);margin-bottom:16px;padding-bottom:10px;border-bottom:1px solid var(--brd);}
.fg{display:flex;flex-direction:column;gap:3px;margin-bottom:12px;}
.fg label{font-size:.6rem;font-weight:800;letter-spacing:1px;color:var(--t3);text-transform:uppercase;}
.fi,.fs,.ft{background:var(--bg2);border:1px solid var(--brd2);color:var(--t);font-size:.88rem;padding:10px 12px;border-radius:var(--r);outline:none;transition:border-color .2s,box-shadow .2s;width:100%;}
.fi:focus,.fs:focus,.ft:focus{border-color:var(--g2);box-shadow:0 0 0 3px var(--g6);}
.ft{resize:vertical;min-height:70px;}
.fr2{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.fr3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;}
.abtn{background:linear-gradient(135deg,var(--g),var(--g2));color:#fff;border:none;font-weight:800;font-size:.88rem;padding:12px 22px;border-radius:var(--r);transition:all .2s;}
.abtn:active{transform:scale(.97);}
.bsm{padding:6px 13px;font-size:.76rem;border-radius:8px;font-weight:700;border:none;transition:all .15s;}
.bs{background:var(--g5);color:var(--g3);border:1px solid var(--brd2);}
.bd{background:var(--red2);color:var(--red);border:1px solid rgba(255,71,87,.2);}
.bw{background:var(--bg2);color:var(--t2);border:1px solid var(--brd);}
.adm-card{background:var(--card);border:1px solid var(--brd);border-radius:var(--r2);padding:14px 16px;margin-bottom:12px;}
.adm-card.lv{border-color:rgba(108,71,255,.4);background:rgba(108,71,255,.06);}
.gc-nm{font-weight:800;font-size:.92rem;display:flex;align-items:center;flex-wrap:wrap;gap:6px;margin-bottom:6px;}
.gc-mt{font-size:.74rem;color:var(--t3);display:flex;gap:12px;flex-wrap:wrap;margin-bottom:8px;}
.gc-ac{display:flex;gap:6px;flex-wrap:wrap;}
.at-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(88px,1fr));gap:8px;}
.at-sl{background:var(--bg2);border:1px solid var(--brd);border-radius:var(--r);padding:10px 8px;text-align:center;cursor:pointer;transition:all .15s;}
.at-sl.bk{border-color:var(--g2);background:var(--g5);}
.at-n{font-family:var(--font-head);color:var(--g3);font-size:1rem;font-weight:800;}
.at-nm{font-size:.64rem;color:var(--t3);margin-top:3px;word-break:break-all;}
.at-st{font-size:.54rem;letter-spacing:.5px;margin-top:2px;font-weight:700;color:var(--t4);}
.wm-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;}
.wm-it{display:flex;align-items:center;gap:8px;background:var(--bg2);border:1px solid var(--brd);border-radius:var(--r);padding:10px 12px;cursor:pointer;transition:all .15s;}
.wm-it:hover{border-color:var(--brd2);}
.wm-it input{accent-color:var(--g2);width:16px;height:16px;}
.wm-it label{cursor:pointer;font-size:.84rem;font-weight:600;flex:1;}
.wm-prize{width:78px;padding:6px 8px;border:1.5px solid var(--brd2);border-radius:6px;background:var(--card);color:var(--t);font-size:.86rem;font-weight:800;text-align:center;outline:none;}
.wm-prize:focus{border-color:var(--g2);}
.rv-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:8px 0;border-bottom:1px solid var(--brd);font-size:.82rem;color:var(--t2);}
.rv-row:last-of-type{border-bottom:none;}
.rv-banner img{display:block;}
.cb{padding:10px 18px;border-radius:var(--r);border:none;font-weight:800;font-size:.86rem;transition:all .15s;}
.cst{background:var(--g5);color:var(--g3);border:1px solid var(--brd2);}
.cpa{background:rgba(255,167,38,0.15);color:#FFA726;border:1px solid rgba(255,167,38,0.25);}
.cen{background:var(--red2);color:var(--red);border:1px solid rgba(255,71,87,.2);}
.notice-item-admin{background:var(--bg2);border:1px solid var(--brd);border-radius:var(--r);padding:11px 14px;margin-bottom:8px;display:flex;align-items:flex-start;gap:10px;}
.nia-txt{flex:1;font-size:.84rem;line-height:1.5;color:var(--t2);}
.nia-acts{display:flex;gap:5px;flex-shrink:0;}
.secban{background:var(--red2);border:1px dashed rgba(255,71,87,.3);border-radius:var(--r);padding:10px 14px;margin-bottom:14px;font-size:.78rem;color:var(--red);font-weight:800;}
#secp{display:none;}#secp.on{display:block;}
.banner-sel-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-bottom:12px;}
.bsel{border:2px solid var(--brd);border-radius:var(--r);overflow:hidden;cursor:pointer;aspect-ratio:1;position:relative;}
.bsel.active{border-color:var(--g2);box-shadow:0 0 0 3px rgba(108,71,255,.2);}
.bsel img{width:100%;height:100%;object-fit:cover;}
.bsel-empty{background:var(--bg2);display:flex;align-items:center;justify-content:center;color:var(--t3);font-size:1.2rem;}
.bsel-del{position:absolute;top:2px;right:2px;background:var(--red);color:#fff;border:none;border-radius:50%;width:18px;height:18px;font-size:.6rem;display:flex;align-items:center;justify-content:center;cursor:pointer;}
/* Badge used in admin JS */
.gc-badge{display:inline-block;padding:3px 10px;border-radius:12px;font-size:.62rem;font-weight:800;letter-spacing:1px;}
.gcb-free{background:var(--g5);color:var(--g3);}
.gcb-paid{background:var(--red2);color:var(--red);}

/* BOOKING PAGE */
.bk-stat-card{background:var(--card);border:1px solid var(--brd);border-radius:var(--r2);padding:12px 8px;text-align:center;}
.bk-stat-val{font-family:var(--font-head);font-size:1.3rem;font-weight:800;color:var(--g3);}
.bk-stat-lbl{font-size:.52rem;letter-spacing:1.5px;color:var(--t3);font-weight:700;margin-top:3px;text-transform:uppercase;}
.bk-sheet-card{border-radius:var(--r2);padding:10px 8px;text-align:center;border:1px solid;}
.bk-sheet-card.single{background:rgba(108,71,255,.1);border-color:rgba(108,71,255,.25);}
.bk-sheet-card.half{background:rgba(0,200,150,.08);border-color:rgba(0,200,150,.3);}
.bk-sheet-card.full{background:rgba(255,107,53,.08);border-color:rgba(255,107,53,.3);}
.bk-sheet-val{font-family:var(--font-head);font-size:1.2rem;font-weight:800;color:var(--t);}
.bk-sheet-lbl{font-size:.5rem;letter-spacing:1px;color:var(--t3);font-weight:700;margin-top:2px;text-transform:uppercase;}
.bk-type-btn{flex-shrink:0;padding:8px 16px;background:var(--card);border:1px solid var(--brd2);border-radius:20px;color:var(--t2);font-size:.78rem;font-weight:700;transition:all .18s;cursor:pointer;}
.bk-type-btn.active{background:var(--g2);border-color:var(--g2);color:#fff;box-shadow:0 3px 12px rgba(108,71,255,.35);}
.bk-chart-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:5px;}
.bk-chart-cell{aspect-ratio:1;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:9px;border:1.5px solid var(--brd2);background:var(--card);transition:all .18s;position:relative;overflow:hidden;cursor:default;}
.bk-chart-cell.booked{background:var(--g2);border-color:var(--g2);box-shadow:0 2px 10px rgba(108,71,255,.35);}
.bk-chart-cell.half-grp{background:rgba(0,200,150,.15);border-color:rgba(0,200,150,.7);}
.bk-chart-cell.full-grp{background:rgba(255,107,53,.15);border-color:rgba(255,107,53,.7);}
.bk-chart-cell.highlight{border-color:var(--gold)!important;border-width:2px!important;box-shadow:0 0 0 3px rgba(244,196,48,.25)!important;}
.bk-cell-num{font-family:'Inter',sans-serif;font-size:.76rem;font-weight:800;line-height:1;color:var(--g3);}
.bk-chart-cell.booked .bk-cell-num{color:#fff;}
.bk-chart-cell.half-grp .bk-cell-num{color:#00C896;}
.bk-chart-cell.full-grp .bk-cell-num{color:#FF6B35;}
.bk-cell-name{font-size:.4rem;font-weight:700;margin-top:3px;color:var(--t3);text-overflow:ellipsis;overflow:hidden;white-space:nowrap;max-width:92%;text-align:center;}
.bk-chart-cell.booked .bk-cell-name{color:rgba(255,255,255,.75);}
.bk-cell-type{position:absolute;top:2px;right:3px;font-size:.36rem;font-weight:800;color:var(--gold);}
.bk-chart-cell.admin-mode{cursor:pointer;}
.bk-chart-cell.admin-mode:not(.booked):hover{border-color:var(--g2);background:var(--g6);}
.bk-chart-cell.admin-mode:active{transform:scale(.93);}
[data-light] .bk-chart-cell:not(.booked){background:#f4f2ff;border-color:rgba(108,71,255,.2);}
[data-light] .bk-chart-cell:not(.booked) .bk-cell-num{color:var(--g2);}
[data-light] .bk-chart-cell.booked{background:var(--g2);border-color:var(--g2);}
.bk-search-box{display:flex;align-items:center;gap:10px;background:var(--card);border:1px solid var(--brd2);border-radius:var(--r2);padding:11px 14px;}
.bk-search-box input{flex:1;border:none;background:none;font-size:.88rem;font-weight:600;color:var(--t);outline:none;}
.bk-search-box input::placeholder{color:var(--t4);}
.bk-search-clear{background:none;border:none;color:var(--t3);font-size:1rem;padding:0 2px;cursor:pointer;}
.assign-box{background:var(--card);border:1px solid var(--brd2);border-radius:var(--r3);padding:24px 20px;width:100%;max-width:320px;box-shadow:var(--sh3);}
.assign-box h3{font-family:var(--font-head);font-size:1rem;font-weight:800;color:var(--g3);margin-bottom:4px;}
.assign-box p{font-size:.75rem;color:var(--t3);margin-bottom:14px;}
.assign-type-row{display:flex;gap:6px;margin-bottom:12px;}
.assign-type-btn{flex:1;padding:8px 4px;background:var(--bg2);border:1px solid var(--brd2);border-radius:var(--r);color:var(--t2);font-size:.7rem;font-weight:700;text-align:center;cursor:pointer;transition:all .15s;}
.assign-type-btn.active{background:var(--g2);border-color:var(--g2);color:#fff;}
.assign-actions{display:flex;gap:8px;margin-top:14px;}
/* T&C footer */
.tc-footer{padding:20px 18px 16px;text-align:center;border-top:1px solid var(--brd);margin-top:10px;}
.tc-link{display:inline-flex;align-items:center;gap:6px;color:var(--t3);font-size:.78rem;font-weight:600;cursor:pointer;border:none;background:none;}
.powered-by{font-size:.64rem;color:var(--t4);margin-top:8px;}
.powered-by b{color:var(--g3);font-weight:700;}
.tc-modal{background:var(--card);border:1px solid var(--brd2);border-radius:var(--r3);padding:24px 20px;width:100%;max-width:420px;max-height:85vh;overflow-y:auto;box-shadow:var(--sh3);}
.tc-modal h3{font-family:var(--font-head);font-size:1rem;font-weight:800;color:var(--g3);margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid var(--brd);}
.tc-modal-item{display:flex;gap:10px;padding:8px 0;border-bottom:1px solid var(--brd);font-size:.82rem;color:var(--t2);line-height:1.6;}
.tc-modal-item:last-child{border-bottom:none;}
.tc-modal-icon{font-size:1rem;flex-shrink:0;width:20px;}
.tc-modal-footer{font-size:.68rem;color:var(--t3);text-align:center;margin-top:14px;line-height:1.7;}
/* Admin bookings */
.legend-item{display:flex;align-items:center;gap:5px;font-size:.7rem;color:var(--t2);font-weight:600;}
.legend-dot{width:12px;height:12px;border-radius:3px;flex-shrink:0;}

/* VISITOR DASHBOARD grid read-only numbered cells */
.vis-bk-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:5px;}
.vis-bk-cell{
  aspect-ratio:1;display:flex;align-items:center;justify-content:center;
  border-radius:7px;font-family:'Inter',sans-serif;font-size:.74rem;font-weight:700;
  border:1.5px solid #ddd;background:#fff;color:#444;
  transition:background .15s,border-color .15s;cursor:default;
  box-shadow:0 1px 3px rgba(0,0,0,.06);width:100%;
}
[data-light] .vis-bk-cell{background:#fff;border-color:#ddd;color:#444;}
body:not([data-light]) .vis-bk-cell{background:var(--card2);border-color:var(--brd);color:var(--t2);}
.vis-bk-cell.booked{background:var(--gold);border-color:var(--gold);color:#1a1a1a;}
body:not([data-light]) .vis-bk-cell.booked{background:var(--g2);border-color:var(--g);color:#fff;}
.vis-bk-cell.highlight{border-color:var(--red)!important;box-shadow:0 0 0 2px rgba(255,71,87,.25)!important;}
/* All Tickets roster list (visitor, read-only) */
.roster-row{display:flex;align-items:center;gap:10px;padding:9px 12px;background:var(--card);border:1px solid var(--brd2);border-radius:8px;margin-bottom:6px;}
.roster-num{font-family:'Inter',sans-serif;font-weight:800;font-size:.8rem;color:var(--t3);min-width:38px;}
.roster-row.booked .roster-num{color:var(--g3);}
.roster-name{flex:1;font-size:.82rem;font-weight:600;color:var(--t2);}
.roster-paid{font-size:.62rem;font-weight:700;padding:2px 8px;border-radius:10px;flex-shrink:0;}
.roster-paid.p{background:rgba(0,200,150,.15);color:#00C896;}
.roster-paid.u{background:var(--red2);color:var(--red);}


/* ADMIN half/full sheet group UI */
.sheet-group{
  border:1.5px solid var(--brd2);border-radius:var(--r);
  margin-bottom:8px;overflow:hidden;
}
.sheet-group-header{
  background:var(--g5);border-bottom:1px solid var(--brd);
  padding:7px 12px;font-size:.7rem;font-weight:800;color:var(--g3);
  letter-spacing:.5px;display:flex;align-items:center;justify-content:space-between;
}
.sheet-group-cells{display:grid;grid-template-columns:repeat(3,1fr);gap:0;}
.sheet-group-cell{
  padding:10px 8px;text-align:center;border-right:1px solid var(--brd);
  cursor:pointer;transition:background .15s;
}
.sheet-group-cell:last-child{border-right:none;}
.sheet-group-cell.booked{background:rgba(108,71,255,.1);}
.sheet-group-cell:hover:not(.booked){background:var(--g6);}
.sheet-group-cell-n{font-family:'Inter',sans-serif;font-size:.85rem;font-weight:800;color:var(--g3);}
.sheet-group-cell-nm{font-size:.62rem;color:var(--t3);margin-top:2px;word-break:break-word;}

/* FULL sheet group (6 cells per group) */
.sheet-group-cells.full-sheet{grid-template-columns:repeat(6,1fr);}

/* NEW T&C MODAL white paper style */
.tc-modal{
  background:#ffffff;border-radius:16px;
  width:100%;max-width:480px;max-height:88vh;
  display:flex;flex-direction:column;
  box-shadow:0 24px 64px rgba(0,0,0,.35);
  overflow:hidden;position:relative;
}
.tc-modal-header{
  padding:20px 48px 16px 20px;
  border-bottom:1px solid #eee;flex-shrink:0;
  background:#fff;
}
.tc-modal-body{
  flex:1;overflow-y:auto;padding:16px 20px;background:#fff;
}
.tc-rule-item{
  display:flex;gap:12px;padding:10px 0;
  border-bottom:1px solid #f0f0f0;font-size:.82rem;color:#333;line-height:1.6;
}
.tc-rule-item:last-of-type{border-bottom:none;}
.tc-rule-num{
  flex-shrink:0;width:22px;height:22px;border-radius:50%;
