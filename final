function renderAdmBkGrid(mode){
  const wrap=document.getElementById('adm-bk-grid-wrap');if(!wrap||!G)return;
  const tickets=G.tickets||{};const tc=G.tc||15;
  if(mode==='single'){
    // Simple grid tap each cell to assign
    let html='<div style="font-size:.7rem;font-weight:700;color:var(--t3);margin-bottom:8px;">Tap a ticket to assign / edit.</div>';
    html+='<div class="bk-chart-grid" id="adm-bk-chart">';
    for(let i=1;i<=tc;i++){
      const t=tickets[i];const isBooked=!!(t&&t.name);
      html+=`<div class="bk-chart-cell admin-mode${isBooked?' booked':''}" onclick="openBkAssign(${i})">
        <div class="bk-cell-num">${p3(i)}</div>
        ${isBooked?`<div class="bk-cell-name">${escHtml(t.name.split(' ')[0])}</div>`:''}
      </div>`;
    }
    html+='</div>';
    wrap.innerHTML=html;
  } else {
    // Group view: 3-per-group for half, 6-per-group for full
    const grpSize=mode==='half'?3:6;
    const numGroups=Math.ceil(tc/grpSize);
    let html=`<div style="font-size:.7rem;font-weight:700;color:var(--t3);margin-bottom:8px;">Select a group slot to assign all ${grpSize} tickets to one person.</div>`;
    for(let g=0;g<numGroups;g++){
      const start=g*grpSize+1;const end=Math.min(start+grpSize-1,tc);
      const isPartial=(end-start+1)<grpSize; // trailing group smaller than grpSize can't be a valid half/full sheet
      const label=mode==='half'?'Half Sheet':'Full Sheet';
      // Check if any in this group are booked
      const anyBooked=Array.from({length:end-start+1},(_,k)=>start+k).some(n=>tickets[n]&&tickets[n].name);
      html+=`<div class="sheet-group">
        <div class="sheet-group-header">
          <span>${label} ${g+1} &nbsp;&mdash;&nbsp; Tickets ${start}–${end}</span>
          ${isPartial?'':(anyBooked?`<button class="bsm bd" style="font-size:.6rem;padding:3px 8px;" onclick="clrGroupBk(${start},${end})">Clear Group</button>`:`<button class="bsm bs" style="font-size:.6rem;padding:3px 8px;" onclick="openGroupAssign(${start},${end},'${mode}')">Assign Group</button>`)}
        </div>
        <div class="sheet-group-cells${mode==='full'?' full-sheet':''}">`;
      for(let n=start;n<=end;n++){
        const t=tickets[n];const isBooked=!!(t&&t.name);
        html+=`<div class="sheet-group-cell${isBooked?' booked':''}" onclick="openBkAssign(${n})">
