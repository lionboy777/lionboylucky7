}

/* ════ WINNER MODE DETECTION ════ */
function getNumsForMode(ticket,modeId){
  const r=ticket.nums;
  const flat=r.flat().filter(Boolean);
  const row=(i)=>r[i].filter(Boolean);
  /* For Plus: middle row + middle number of each row (index 4 in sorted positions) */
  function middleNum(row){const ns=row.filter(Boolean);return ns[Math.floor(ns.length/2)]||null;}
  const midCol=[r[0],r[1],r[2]].map(row=>middleNum(row)).filter(Boolean);
  const midRow=row(1);
  const plusNums=[...new Set([...midRow,...midCol])];
  /* Pyramid: 3rd num of top, 2nd&4th of mid, 1st,3rd,5th of bot */
  function nthNum(row,idx){const ns=row.filter(Boolean);return ns[idx]||null;}
  const pyramidNums=[nthNum(r[0],2),nthNum(r[1],1),nthNum(r[1],3),nthNum(r[2],0),nthNum(r[2],2),nthNum(r[2],4)].filter(Boolean);
  /* Diamond: 3rd of row0&row2, 1st&last of row1 */
  const diamondNums=[nthNum(r[0],2),nthNum(r[2],2),...[row(1)[0],row(1)[row(1).length-1]]].filter(Boolean);
  const map={
    'early5':flat.slice(0,5),
    'topline':row(0),
    'midline':row(1),
    'botline':row(2),
    'corners':[row(0)[0],row(0)[row(0).length-1],row(2)[0],row(2)[row(2).length-1]].filter(Boolean),
    'sixcorners':[row(0)[0],row(0)[row(0).length-1],row(1)[0],row(1)[row(1).length-1],row(2)[0],row(2)[row(2).length-1]].filter(Boolean),
    'pyramid':pyramidNums,
    'plus':plusNums,
    'diamond':diamondNums,
    'fullhouse':flat,
  };
  return map[modeId]||[];
}

function checkMode(ticket,modeId,calledSet){
  if(modeId==='early5'){return ticket.nums.flat().filter(Boolean).filter(n=>calledSet.has(n)).length>=5;}
  const needed=getNumsForMode(ticket,modeId);
  return needed.length>0&&needed.every(n=>calledSet.has(n));
}

