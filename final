/* ════ FIREBASE LISTENERS ════ */
function startListeners(){
  /* Game */
  db.ref('game').on('value',snap=>{
    const prev=G?JSON.parse(JSON.stringify(G)):null;
    G=snap.val();
    if(G){
      G.called=G.called?Object.values(G.called).filter(Boolean):[];
      G.tickets=G.tickets||{};
      G.winners=G.winners?Object.values(G.winners).filter(Boolean):[];
      G.wm=G.wm||[];
      G.wmPrizes=G.wmPrizes||{};
      G.fw=G.fw||{};
      G.sequence=G.sequence?Object.values(G.sequence).filter(Boolean):null;
    }
    updateState();
    updateHero();
    updateBoards();
    updateStats();
    renderVisTix();
    renderLiveWinners();
    renderFreeNavVisibility();
    checkNewWinners(prev);
    if(G&&G.status==='live'){
      if(!L.isAdmin&&G.called.length>0){
        const n=G.called[G.called.length-1];
        // Gate on the NUMBER itself, not just array length/lock timing  
        // this is what stopped the "first call shows multiple numbers"
        // bug: a burst of Firebase snapshots (e.g. called write followed
        // quickly by an unrelated game-node write) could previously pass
        // the length+lock check more than once for numbers already shown.
        if(n!==L.lastShown){
          L.lastShown=n;
          showNumber(n);
          if(!L.audioLock)playNum(n,()=>{});
        }
      }
      // Admin: suppress duplicate show for the number they just called via callNext()
      if(L.isAdmin&&G.called.length>0){
        const n=G.called[G.called.length-1];
        if(n!==L.lastShown&&n!==L.lastAdminCalled){
          // Admin reconnected mid-game show latest number
          L.lastShown=n;
          showNumber(n);
        }
      }
      startElTimer();
    }
    hideLoading();
  },err=>{
    // CRITICAL: without this, a permission-denied or network error leaves
    // the loading screen spinning forever with no feedback to the user.
    console.error('Firebase game read error:',err);
    hideLoading();
    const el=document.getElementById('loading-error');
    if(el){
      el.style.display='block';
      el.textContent='Could not connect: '+(err.message||'unknown error')+'. Check Firebase database rules allow public read access.';
    }
    toast('Connection failed check Firebase rules');
  });
  /* Free Game independent slot; shares the Live section with the paid
     game whenever it's the one currently live (see LG()). */
  db.ref('gameFree').on('value',snap=>{
    const prevF=GF?JSON.parse(JSON.stringify(GF)):null;
    GF=snap.val();
    if(GF){
      GF.called=GF.called?Object.values(GF.called).filter(Boolean):[];
      GF.tickets=GF.tickets||{};
      GF.winners=GF.winners?Object.values(GF.winners).filter(Boolean):[];
      GF.wm=GF.wm||[];
      GF.wmPrizes=GF.wmPrizes||{};
      GF.fw=GF.fw||{};
      GF.sequence=GF.sequence?Object.values(GF.sequence).filter(Boolean):null;
    }
    updateBoards();
    updateStats();
    renderLiveTicketList();
    renderLiveWinners();
    checkNewWinnersFree(prevF);
    renderFreePage();
    renderFreeNavVisibility();
    if(GF&&GF.status==='live'){
      if(!L.isAdmin&&GF.called.length>0){
        const n=GF.called[GF.called.length-1];
        if(n!==L.lastShown){
          L.lastShown=n;
          showNumber(n);
          if(!L.audioLock)playNum(n,()=>{});
        }
      }
      if(L.isAdmin&&GF.called.length>0){
        const n=GF.called[GF.called.length-1];
        if(n!==L.lastShown&&n!==L.lastAdminCalled){
          L.lastShown=n;
          showNumber(n);
        }
      }
      startElTimer();
    }
  },err=>{console.error('Firebase gameFree read error:',err);});
  /* Notices */
  db.ref('notices').on('value',snap=>{
    const data=snap.val();
    const el=document.getElementById('notices-sec');
    if(!data||!Object.keys(data).length){el.innerHTML='';return;}
    const list=Object.values(data).sort((a,b)=>(a.time||0)-(b.time||0));
    el.innerHTML='<div class="notices-wrap">'+list.map(n=>`<div class="notice-card"><div class="notice-txt">${n.text}</div><div class="notice-time">Posted: ${new Date(n.time||Date.now()).toLocaleString()}</div></div>`).join('')+'</div>';
  });
  /* Social + Contact all rendered as slim pills in one row */
  db.ref('social').on('value',snap=>{
    const d=snap.val()||{};
    const el=document.getElementById('soc-sec');
    const bs=[];
    if(d.ig)bs.push(`<a class="soc-ig" href="${d.ig}" target="_blank">Instagram</a>`);
    if(d.tg)bs.push(`<a class="soc-tg" href="${d.tg}" target="_blank">Telegram</a>`);
    el.innerHTML=bs.join('');el.style.display=bs.length?'flex':'none';
    const waLink=document.getElementById('nh-wa-link');
    const callLink=document.getElementById('nh-call-link');
    L.waLink=d.wa||'';
    if(waLink){waLink.href=d.wa||'#';waLink.style.display=d.wa?'flex':'none';}
    if(callLink){callLink.href=d.phone?('tel:'+d.phone):'#';callLink.style.display=d.phone?'flex':'none';}
  });
  /* Viewers */
  const vRef=db.ref('viewers/'+uid());
  vRef.set({t:Date.now()});
  vRef.onDisconnect().remove();
  db.ref('viewers').on('value',snap=>{
    const c=snap.numChildren();
    const el=document.getElementById('vcn');if(el)el.textContent=c;
  });
  /* Banners load from Firebase */
  db.ref('banners').on('value',snap=>{
    const data=snap.val();
    if(data&&Array.isArray(data))L.banners=data;
    else if(data&&typeof data==='object')L.banners=Object.values(data).slice(0,5);
  });
  /* Previous games */
  db.ref('previous').on('value',snap=>{
    // handled in renderPrevious
  });
}

/* ════ WIN DETECTION (visitor side) ════ */
function checkNewWinners(prev){
  if(!G||!G.winners)return;
  const prevCount=prev&&prev.winners?prev.winners.length:L.lastWinCount;
  if(G.winners.length>prevCount){
    const newW=G.winners[G.winners.length-1];
    if(newW){
      if(newW.m==='fullhouse'){
        if(!L.isAdmin)playWin();
        showWin(newW.name||('Ticket #'+p3(newW.t)),newW.m,newW.unbooked,newW.prize);
        doConfetti();
      } else {
        // Partial win toast + confetti for everyone
        toast((newW.name||'Ticket #'+p3(newW.t))+' wins '+getModeLabel(newW.m)+(newW.prize?(' ₹'+newW.prize):''),3500);
        doConfetti();
      }
    }
  }
  L.lastWinCount=G.winners.length;
}
