/* ════ AUTO-CALLING (admin only, strict sequential) ════ */
// L.callGen increments every time calling restarts. Any in-flight callNext()
// from a PREVIOUS generation checks this and aborts instead of proceeding  
// this is what stops a stale/duplicate trigger right after game start from
// firing a second call in the same moment as the real one.
function startCalling(){
  if(!L.isAdmin)return;
  stopCalling();
  L.calling=true;
  L.audioLock=false;
  L.callGen=(L.callGen||0)+1;
  const myGen=L.callGen;
  callNext(myGen);
}
function stopCalling(){
  if(L.callTmr)clearTimeout(L.callTmr);
  L.calling=false;
  L.callGen=(L.callGen||0)+1; // invalidates any in-flight callNext from this generation
}
function pauseCall(){stopCalling();stopAudio();renderLCtrl();toast('⏸ Paused.');}
function resumeCall(){if(!L.calling){startCalling();renderLCtrl();toast('Resumed.');}}

function callNext(gen){
  // Guard: if calling was stopped/restarted since this specific call was
  // scheduled, abort silently. This is the fix for the "two numbers on
  // auto-start" bug it can no longer matter if a stale invocation lands.
  if(gen!==L.callGen)return;
  if(!L.calling||!L.isAdmin)return;
  const AG=LG();const path=liveGamePath();
  if(!AG||AG.status!=='live'){stopCalling();return;}

  // Strict lock if audio is still playing from previous call, wait
  if(L.audioLock){L.callTmr=setTimeout(()=>callNext(gen),400);return;}

  const called=AG.called||[];
  const rem=[];for(let i=1;i<=90;i++)if(!called.includes(i))rem.push(i);
  if(!rem.length){stopCalling();toast('All 90 numbers called.');return;}

  // If admin has locked a pre-built 90-number sequence for whichever game
  // is live, read the next number from it in order instead of picking
  // randomly. Works identically for paid and free — no other special-casing
  // needed, since the sequence itself was already simulated and verified to
  // produce the intended winners before it was locked.
  const lockedSeq=(AG.sequence&&Array.isArray(AG.sequence)&&AG.sequence.length===90)?AG.sequence:null;

  let n;
  if(lockedSeq){
    n=lockedSeq[called.length];
    if(!n){stopCalling();toast('All 90 numbers called.');return;}
  } else {
    // No locked sequence — 100% honest random calling
    n=rem[Math.floor(Math.random()*rem.length)];
  }
  // ── END CALL PICKER ──────────────────────────────────────────────────────

  const newCalled=[...called,n];

  // Mark this number as "admin already handled" to suppress Firebase listener duplicate
  L.lastAdminCalled=n;
  L.audioLock=true; // lock BEFORE Firebase write to prevent listener race

  // Write to Firebase all clients see it
  db.ref(path+'/called').set(newCalled).then(()=>{
    if(gen!==L.callGen)return; // calling was stopped/restarted while write was in flight
    // Update display for admin
    showNumber(n);
    // Check for winners
    checkWinnersAdmin(newCalled);
    if(!L.calling){L.audioLock=false;return;}
    // Play audio schedule next ONLY when audio finishes + gap
    playNum(n,()=>{
      if(gen!==L.callGen){L.audioLock=false;return;}
      if(!L.calling){L.audioLock=false;return;}
      // After audio ends + 2s buffer = smooth 6s+ between calls
      L.callTmr=setTimeout(()=>{
        L.audioLock=false;
        callNext(gen);
      },2000);
    });
  }).catch(e=>{
    console.error('Firebase write error:',e);
    L.audioLock=false;
    L.callTmr=setTimeout(()=>callNext(gen),3000);
  });
}

