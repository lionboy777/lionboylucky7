function handleBannerFile(idx,inputEl){
  const file=inputEl.files&&inputEl.files[0];if(!file)return;
  const statusEl=document.getElementById('bf-'+idx+'-status');
  if(statusEl)statusEl.textContent='Processing image...';
  const reader=new FileReader();
  reader.onload=function(e){
    const img=new Image();
    img.onload=function(){
      const maxW=900;
      const scale=Math.min(1,maxW/img.width);
      const w=Math.round(img.width*scale),h=Math.round(img.height*scale);
      const cv=document.createElement('canvas');cv.width=w;cv.height=h;
      cv.getContext('2d').drawImage(img,0,0,w,h);
      const dataUrl=cv.toDataURL('image/jpeg',0.78);
      const sizeKB=Math.round(dataUrl.length*0.75/1024);
      const bi=document.getElementById('bi-'+idx);if(bi)bi.value=dataUrl;
      L.banners[idx]=dataUrl;
      if(statusEl)statusEl.textContent=sizeKB>500
        ?sizeKB+' KB quite large. Tap "Save Banners" to publish anyway, or try a smaller photo.'
        :'Ready ('+sizeKB+' KB). Tap "Save Banners" to publish.';
      renderBannerInputs();
    };
    img.onerror=function(){if(statusEl)statusEl.textContent='Could not read that image try a different file.';};
    img.src=e.target.result;
  };
  reader.onerror=function(){if(statusEl)statusEl.textContent='Could not read that file.';};
  reader.readAsDataURL(file);
}
function saveBanners(){
  for(let i=0;i<5;i++){const el=document.getElementById('bi-'+i);if(el)L.banners[i]=el.value.trim();}
  db.ref('banners').set(L.banners).then(()=>{renderBannerSel();toast('Banners saved.');}).catch(e=>toast('Error: '+e.message));
