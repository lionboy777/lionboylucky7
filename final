/* Counts bookings correctly: a half/full sheet booked as one group counts as
   ONE booking (not one per ticket inside it). Groups are identified by groupId. */
function countBookingsByType(tickets){
  const seenGroups=new Set();
  let single=0,half=0,full=0;
  Object.values(tickets).forEach(t=>{
    if(!t||!t.name)return;
    if(t.bookType==='half'||t.bookType==='full'){
      if(t.groupId&&seenGroups.has(t.groupId))return; // already counted this group's booking
      if(t.groupId)seenGroups.add(t.groupId);
      if(t.bookType==='half')half++;else full++;
    } else {
      single++;
    }
  });
  return {single,half,full};
}
