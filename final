const CD_NORMAL_HTML='<div class="flip-group"><div class="flip-digit" id="cdh1">-</div><div class="flip-digit" id="cdh2">-</div></div><div class="flip-group"><div class="flip-digit" id="cdm1">-</div><div class="flip-digit" id="cdm2">-</div></div><div class="flip-group"><div class="flip-digit" id="cds1">-</div><div class="flip-digit" id="cds2">-</div></div>';
