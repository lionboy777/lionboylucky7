  --blur:18px;
  --font-head:'Space Grotesk',sans-serif;
  --font-body:'Inter',sans-serif;
  --font-num:'IBM Plex Mono',monospace;
}
[data-light]{
  --w:#ffffff;--bg:#F1F2F6;--bg2:#E7E9F0;
  --card:rgba(255,255,255,0.55);--card2:rgba(255,255,255,0.75);
  --t:#181A22;--t2:#4A4E5E;--t3:#7B7F91;--t4:#C4C6D2;
  --brd:rgba(20,20,30,0.08);--brd2:rgba(20,20,30,0.14);
  --g5:rgba(110,98,232,0.09);--g6:rgba(110,98,232,0.05);
  --sh:0 2px 14px rgba(20,20,40,0.06);--sh2:0 8px 28px rgba(20,20,40,0.09);--sh3:0 16px 48px rgba(20,20,40,0.12);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
body{font-family:var(--font-body);background:var(--bg);color:var(--t);min-height:100vh;overflow-x:hidden;}


button,a{cursor:pointer;font-family:var(--font-body);}
input,select,textarea{font-family:var(--font-body);}
::-webkit-scrollbar{width:4px;height:4px;}
::-webkit-scrollbar-thumb{background:var(--g2);border-radius:4px;opacity:.5;}
::-webkit-scrollbar-track{background:transparent;}
/* Reusable glass panel */
.glass{background:var(--card);border:1px solid var(--brd);backdrop-filter:blur(var(--blur));-webkit-backdrop-filter:blur(var(--blur));border-radius:var(--r2);box-shadow:var(--sh);}
.num{font-family:var(--font-num);font-variant-numeric:tabular-nums;}

/* LOADING */
#loading{position:fixed;inset:0;z-index:9999;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;transition:opacity .5s;}
#loading.hide{opacity:0;pointer-events:none;}
.ld-lion{width:52px;height:52px;animation:ldpulse 1.4s ease-in-out infinite;opacity:.9;color:var(--gold);}
@keyframes ldpulse{0%,100%{transform:scale(1);opacity:.7;}50%{transform:scale(1.06);opacity:1;}}
.ld-title{font-family:var(--font-head);font-size:1.1rem;color:var(--t);font-weight:600;letter-spacing:.3px;}
.ld-sub{font-size:.72rem;color:var(--t3);letter-spacing:.5px;}
.ld-bar{width:160px;height:2px;background:var(--g5);border-radius:2px;overflow:hidden;}
.ld-prog{height:100%;background:linear-gradient(90deg,var(--g2),var(--gold));border-radius:2px;animation:ldbar 1.6s ease-in-out infinite;}
@keyframes ldbar{0%{width:0;margin-left:0;}50%{width:60%;margin-left:20%;}100%{width:0;margin-left:100%;}}

/* TOPBAR */
#topbar{position:fixed;top:0;left:0;right:0;z-index:200;height:60px;display:flex;align-items:center;justify-content:space-between;padding:0 14px;background:rgba(10,11,16,0.72);backdrop-filter:blur(var(--blur));-webkit-backdrop-filter:blur(var(--blur));border-bottom:1px solid var(--brd);}
[data-light] #topbar{background:rgba(255,255,255,0.72);}
.tb-brand{display:flex;align-items:center;gap:10px;cursor:pointer;}
.tb-name{font-family:var(--font-head);font-size:1rem;font-weight:600;color:var(--t);letter-spacing:.2px;}
.tb-sub{font-size:.44rem;letter-spacing:2.5px;color:var(--t3);font-weight:600;display:block;margin-top:1px;}
.tb-right{display:flex;align-items:center;gap:8px;}
.live-pill{display:none;align-items:center;gap:6px;background:var(--red2);color:var(--red);border:1px solid rgba(229,99,122,.3);border-radius:20px;padding:5px 12px;font-size:.66rem;font-weight:700;letter-spacing:.4px;}
.live-pill.on{display:flex;}
.ldot{width:6px;height:6px;background:currentColor;border-radius:50%;animation:bl 1.1s infinite;}
@keyframes bl{0%,100%{opacity:1;}50%{opacity:.3;}}
.icnbtn{background:var(--card);border:1px solid var(--brd);color:var(--t2);width:38px;height:38px;border-radius:11px;display:flex;align-items:center;justify-content:center;transition:all .16s;backdrop-filter:blur(var(--blur));}
.icnbtn:active{transform:scale(.92);}
.icnbtn svg{width:17px;height:17px;}
.icnbtn.is-admin{color:#fff;background:var(--g2);border-color:var(--g2);}

/* MENU */
#menu-bg{display:none;position:fixed;inset:0;z-index:400;background:rgba(0,0,0,.5);backdrop-filter:blur(6px);}
#menu-bg.on{display:block;}
#menu{position:fixed;top:0;right:-300px;bottom:0;width:284px;z-index:401;background:var(--w);border-left:1px solid var(--brd);box-shadow:var(--sh3);transition:right .28s cubic-bezier(.4,0,.2,1);overflow-y:auto;display:flex;flex-direction:column;}
[data-light] #menu{background:#ffffff;}
#menu.on{right:0;}
.m-head{padding:20px 18px 16px;display:flex;align-items:center;gap:12px;border-bottom:1px solid var(--brd);}
.m-brand{font-family:var(--font-head);font-size:.94rem;font-weight:600;color:var(--t);}
.m-sub{font-size:.44rem;letter-spacing:2.5px;color:var(--t3);font-weight:600;display:block;margin-top:2px;}
.m-x{margin-left:auto;background:var(--card2);border:1px solid var(--brd);color:var(--t2);width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:.95rem;}
.m-sec{padding:6px 0;}
.m-lbl{font-size:.68rem;font-weight:600;letter-spacing:.2px;color:var(--t3);padding:14px 18px 6px;}
.m-item{display:flex;align-items:center;gap:12px;padding:11px 18px;background:none;border:none;width:100%;text-align:left;color:var(--t2);font-size:.87rem;font-weight:500;transition:all .15s;border-left:2px solid transparent;}
.m-item:hover,.m-item.on{color:var(--t);background:var(--g6);border-left-color:var(--g2);}
.m-div{height:1px;background:var(--brd);margin:4px 18px;}
.m-theme{display:flex;align-items:center;justify-content:space-between;padding:10px 18px;}
.m-theme span{font-size:.85rem;color:var(--t2);font-weight:500;}
.tsw{width:40px;height:22px;background:var(--card2);border:1px solid var(--brd2);border-radius:11px;position:relative;cursor:pointer;transition:background .2s;}
.tsw::after{content:'';position:absolute;top:2px;left:2px;width:16px;height:16px;background:var(--t3);border-radius:50%;transition:left .2s;}
.tsw.on{background:var(--g2);border-color:var(--g);}
.tsw.on::after{left:20px;background:#fff;}
.m-admin-btn{margin:10px 14px;background:var(--g5);color:var(--g3);border:1px solid var(--brd2);border-radius:var(--r2);padding:12px;font-weight:700;font-size:1.3rem;width:calc(100% - 28px);display:flex;align-items:center;justify-content:center;}
[data-light] .m-admin-btn{background:rgba(108,71,255,.08);color:var(--g2);}

/* OVERLAYS */
.ov{display:none;position:fixed;inset:0;z-index:500;background:rgba(0,0,0,.72);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);align-items:center;justify-content:center;padding:16px;}
.ov.on{display:flex;}
#loginbox{background:var(--card);border:1px solid var(--brd2);border-radius:var(--r3);padding:32px 26px;width:100%;max-width:340px;text-align:center;box-shadow:var(--sh3);}
#loginbox h2{font-family:var(--font-head);color:var(--g3);font-size:1.3rem;margin-bottom:4px;}
#loginbox p{color:var(--t3);font-size:.8rem;margin-bottom:18px;}
.inp{width:100%;padding:12px 14px;border:1px solid var(--brd2);border-radius:var(--r);background:var(--bg2);color:var(--t);font-size:.9rem;font-weight:600;outline:none;transition:border-color .2s,box-shadow .2s;margin-bottom:10px;}
.inp:focus{border-color:var(--g2);box-shadow:0 0 0 3px var(--g6);}
.gbtn{width:100%;padding:13px;background:linear-gradient(135deg,var(--g),var(--g2));color:#fff;border:none;border-radius:var(--r);font-weight:800;font-size:.92rem;transition:opacity .2s;}
.gbtn:active{opacity:.85;}
.cbtn{background:none;border:1px solid var(--brd2);color:var(--t3);font-size:.82rem;padding:10px;border-radius:var(--r);width:100%;margin-top:8px;font-weight:600;}
#lerr{color:var(--red);font-size:.76rem;margin-top:5px;display:none;}
#modbox{background:var(--card);border:1px solid var(--brd);border-radius:var(--r3);padding:22px 18px;width:100%;max-width:440px;max-height:88vh;overflow-y:auto;box-shadow:var(--sh3);}
#modbox h3{font-family:var(--font-head);font-size:1rem;font-weight:800;margin-bottom:14px;color:var(--g3);}
.macts{display:flex;gap:8px;margin-top:16px;flex-wrap:wrap;}
.confirm-box{background:var(--card);border:1px solid var(--brd2);border-radius:var(--r3);padding:26px 22px;width:100%;max-width:310px;text-align:center;box-shadow:var(--sh3);}
.confirm-box h3{font-family:var(--font-head);font-size:1.05rem;color:var(--t);margin-bottom:8px;}
.confirm-box p{color:var(--t3);font-size:.84rem;margin-bottom:20px;}
.confirm-btns{display:flex;gap:10px;}
.confirm-btns button{flex:1;padding:12px;border-radius:var(--r);font-weight:800;font-size:.88rem;border:none;}
.btn-yes{background:var(--red);color:#fff;}
.btn-no{background:var(--bg2);color:var(--t2);border:1px solid var(--brd)!important;}
#toast{position:fixed;bottom:28px;left:50%;transform:translateX(-50%);background:var(--w);color:var(--t);padding:12px 22px;border-radius:12px;font-size:.82rem;font-weight:600;display:none;z-index:9999;white-space:nowrap;box-shadow:var(--sh2);border:1px solid var(--brd2);}
#cnf{position:fixed;inset:0;pointer-events:none;z-index:998;display:none;}
#win-ov{flex-direction:column;}
#win-ov.on{display:flex;}
.wbox{background:var(--card);border:1px solid var(--brd2);border-radius:var(--r3);padding:32px 24px;text-align:center;width:100%;max-width:340px;box-shadow:var(--sh3);border-top:4px solid var(--gold);}
.wtroph{width:56px;height:56px;display:block;margin:0 auto 14px;color:var(--gold);animation:bob 1.6s ease-in-out infinite;}
@keyframes bob{0%,100%{transform:translateY(0);}50%{transform:translateY(-12px);}}
.wtitle{font-family:var(--font-head);font-size:1.8rem;font-weight:800;color:var(--gold);margin-bottom:4px;}
.wmode{font-size:.65rem;font-weight:800;letter-spacing:2.5px;color:var(--t3);margin-bottom:6px;text-transform:uppercase;}
.wname{font-size:1.4rem;font-weight:900;color:var(--t);margin-bottom:6px;}
.wprize{font-size:1.1rem;font-weight:800;color:var(--gold);margin-bottom:6px;}
.wstatus{font-size:.78rem;color:var(--t3);margin-bottom:20px;}
.wclose{background:linear-gradient(135deg,var(--g),var(--g2));color:#fff;border:none;border-radius:var(--r2);padding:13px 28px;font-weight:800;font-size:.9rem;transition:transform .15s;}
.wclose:active{transform:scale(.96);}

/* PAGES */
.pg{display:none;padding-top:60px;min-height:100vh;}
#home-pg{padding-top:0;}
/* DASHBOARD (matches supplied design) */
#dashboard-pg{padding-top:0;}
.dash-frame{margin:14px 10px 0;background:#FF821B;border:3px solid #FFD400;border-radius:12px;padding:8px 10px 12px;}
.dash-head{background:#000;border-radius:14px;display:flex;align-items:center;justify-content:space-between;padding:8px 10px;margin-bottom:8px;}
.dash-title{font-family:'Anton','Impact','Haettenschweiler','Arial Black',sans-serif;color:#F4FE81;font-size:1.9rem;letter-spacing:1px;flex:1;text-align:center;}
.dash-x{background:none;border:none;color:#FE0000;font-size:1.3rem;font-weight:800;width:48px;text-align:right;}
.dash-back{background:none;border:none;color:#F4FE81;font-size:.78rem;font-weight:700;width:48px;text-align:left;}
.dash-gname{font-size:.78rem;font-weight:700;color:#000;text-align:center;margin-bottom:6px;}
.dash-search input{width:100%;padding:12px 14px;border:none;border-radius:8px;font-size:1rem;background:#fff;color:#333;outline:none;}
#bk-found>div{background:#fff!important;color:#111!important;}
.dash-gridwrap{background:#CF00AC;padding:6px;border:1px solid #fff;margin-top:8px;max-height:62vh;overflow-y:auto;}
.dash-gridwrap .vis-bk-grid{gap:6px;}
.dash-gridwrap .vis-bk-cell{aspect-ratio:auto;height:36px;border-radius:3px;background:#EFEFEF;color:#000;border:1px solid #b9b9b9;font-family:'Inter',sans-serif;font-weight:700;font-size:.95rem;box-shadow:none;}
.dash-gridwrap .vis-bk-cell.booked{background:#FFFF00;color:#000;border-color:#b9b9b9;}
.dash-gridwrap .vis-bk-cell.highlight{outline:3px solid #FE0000;outline-offset:-1px;}
.dash-book{width:100%;margin-top:8px;background:#FE0000;color:#fff;border:none;border-radius:8px;padding:13px;font-weight:700;font-size:.95rem;letter-spacing:.3px;}
.dash-book:active{transform:scale(.98);}
.dash-stat{margin-top:8px;border:3px solid #FE0000;border-radius:14px;text-align:center;padding:6px 4px;font-weight:800;color:#000;font-size:1.3rem;line-height:1.15;text-shadow:0 0 8px rgba(0,0,0,.3);}
.dash-stat b{display:block;font-size:1.5rem;}
.dash-allhd{color:#fff;font-family:'Anton','Impact','Haettenschweiler','Arial Black',sans-serif;font-size:1.3rem;letter-spacing:.5px;padding:18px 14px 8px;text-shadow:0 1px 4px #000;}

/* Live page contrast over textured background */
#live-pg::before{display:none;}
#live-pg>*{position:relative;z-index:1;}
/* Home: readable text over textured background */
#home-pg .notice-card{background:#fff9d6;border-color:#000;}
#home-pg .notice-txt{color:#222;}
#home-pg .coming-soon-wrap{background:rgba(0,0,0,.62);margin:18px 16px 0;border-radius:14px;padding:22px 18px;}
#home-pg .cs-sub{color:#fff;font-weight:600;}
#ghero .prize-banner{--t:#fff;--t2:#fff;--t3:rgba(255,255,255,.88);--card2:rgba(0,0,0,.25);--brd:rgba(0,0,0,.35);--brd2:rgba(0,0,0,.45);--g5:rgba(0,0,0,.22);--g3:#F4FE81;--gold:#F4FE81;background:#0EA691;border:4px solid #000;backdrop-filter:none;-webkit-backdrop-filter:none;}
body #dashboard-pg .dash-gridwrap .vis-bk-cell{background:#EFEFEF;color:#000;border:1px solid #b9b9b9;}
body #dashboard-pg .dash-gridwrap .vis-bk-cell.booked{background:#FFFF00;color:#000;border-color:#b9b9b9;}

#live-pg{--t2:#e6e8f2;--t3:rgba(255,255,255,.78);--g3:#b9b2ff;}

#live-pg .live-top::after{display:none;}
#live-pg .board-section{background:rgba(0,0,0,.35);border-radius:14px;margin:0 10px;padding-left:6px;padding-right:6px;}
.tb-back{font-size:1.8rem;color:var(--t);margin-right:6px;line-height:1;}
/* SHARED TEXTURED BACKGROUND (home, dashboard, live, notice) */
.textured-bg{min-height:100vh;}
/* NEW BRANDED HOME HEADER (matches supplied design) */
.nh-wrap{padding:10px 10px 0;}
.nh-frame{
  background:#0EA691;border:5px solid #000;border-radius:18px;
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 12px;position:relative;overflow:visible;min-height:96px;
  gap:8px;
}
.nh-titles{display:flex;flex-direction:column;line-height:.92;flex-shrink:0;}
.nh-titles div{font-family:'Anton','Impact','Haettenschweiler','Arial Black',sans-serif;font-size:1.7rem;letter-spacing:.5px;}
.nh-l1{color:#000;}
.nh-l2{color:#fff;}
.nh-l3{color:#F4FE81;}
.nh-logo-wrap{flex:1;display:flex;justify-content:center;position:relative;}
.nh-logo{width:128px;height:128px;object-fit:contain;position:relative;z-index:2;filter:drop-shadow(0 6px 14px rgba(0,0,0,.45));}
.nh-icons{display:flex;flex-direction:column;gap:7px;flex-shrink:0;}
.nh-icon{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;border:none;transition:transform .15s;}
.nh-icon:active{transform:scale(.9);}
.nh-icon svg{width:19px;height:19px;}
.nh-wa{background:#25D366;color:#fff;}
.nh-call{background:#25D366;color:#fff;}
.nh-profile{background:#0EA691;border:2px solid #1a1a1a;color:#1a1a1a;}
