/* ════ WINNER DETECTION (admin only writes to Firebase) ════ */
function checkWinnersAdmin(allCalled){
  if(!L.isAdmin)return;
  const AG=LG();const path=liveGamePath();
  if(!AG)return;
  const cs=new Set(allCalled);
  const wonModes=new Set((AG.winners||[]).map(w=>w.m));
  const wm=AG.wm||[];
  const tc=AG.tc||15;
  const tickets=AG.tickets||{};
  const newWins=[];
  for(let tn=1;tn<=tc;tn++){
    const t=tickets[tn];if(!t)continue;
    wm.forEach(modeId=>{
      if(modeId==='fullsheetbonus'||modeId==='halfsheetbonus')return;
      if(wonModes.has(modeId))return;
      if(checkMode(t,modeId,cs)){
        wonModes.add(modeId);
        const prize=AG.wmPrizes&&AG.wmPrizes[modeId]?AG.wmPrizes[modeId]:0;
        const wname=t.name||t.username||null;
        newWins.push({t:tn,name:wname,m:modeId,unbooked:!wname,prize,time:Date.now()});
      }
    });
  }
  // Sheet bonuses group-based: needs EVERY ticket in a same-buyer half/full
  // sheet to individually have ≥2 numbers marked. Single-ticket bookings can
  // never qualify since they never carry a groupId.
  [['fullsheetbonus','full_',6],['halfsheetbonus','half_',3]].forEach(([modeId,prefix,size])=>{
    if(!wm.includes(modeId)||wonModes.has(modeId))return;
    const groups={};
    Object.entries(tickets).forEach(([k,v])=>{
      if(v&&v.groupId&&String(v.groupId).indexOf(prefix)===0){
        (groups[v.groupId]=groups[v.groupId]||[]).push({tn:parseInt(k),t:v});
      }
    });
    const groupIds=Object.keys(groups).sort((a,b)=>{
      const aMin=Math.min(...groups[a].map(x=>x.tn)),bMin=Math.min(...groups[b].map(x=>x.tn));
      return aMin-bMin;
    });
    for(const gid of groupIds){
      const members=groups[gid];
      if(members.length<size)continue; // incomplete/broken group, skip
      const allQualify=members.every(({t})=>t.nums.flat().filter(Boolean).filter(n=>cs.has(n)).length>=2);
      if(allQualify){
        wonModes.add(modeId);
        const repTn=Math.min(...members.map(x=>x.tn));
        const repT=tickets[repTn];
        const prize=AG.wmPrizes&&AG.wmPrizes[modeId]?AG.wmPrizes[modeId]:0;
        const wname=repT.name||repT.username||null;
        newWins.push({t:repTn,name:wname,m:modeId,unbooked:!wname,prize,time:Date.now(),sheetTix:members.map(x=>x.tn)});
        break; // only the first qualifying sheet wins this bonus
      }
    }
  });
  if(!newWins.length)return;
  const hasFullhouse=newWins.some(w=>w.m==='fullhouse');
  if(hasFullhouse)stopCalling();
  const current=AG.winners||[];
  db.ref(path+'/winners').set([...current,...newWins]).then(()=>{
    if(hasFullhouse)playWin();
  });
}

