function renderSec(){
  const el=document.getElementById('secgames');
  if(!el)return;
  try{
    const blocks=[renderSeqBlock('game'),renderSeqBlock('gameFree')].filter(Boolean);
    el.innerHTML=blocks.length?blocks.join(''):'<p style="color:var(--t3);font-style:italic;font-size:.84rem;">No active game found. Start a game first then come back here.</p>';
  }catch(e){
    el.innerHTML='<p style="color:var(--red);font-size:.82rem;">Panel error: '+escHtml(e.message)+'</p>';
    console.error('renderSec failed:',e);
  }
}
function renderSeqBlock(gk){
  try{
  const g=gk==='gameFree'?GF:G;
  if(!g||g.status==='ended')return null;
  const isFree=gk==='gameFree';
  const nameField=isFree?'username':'name';
  const badgeStyle=isFree?'background:var(--g5);color:var(--g3);':'background:rgba(108,71,255,.15);color:#6C47FF;';
  const tickets=g.tickets||{};
  const wm=(g.wm||[]).filter(id=>id!=='fullsheetbonus'&&id!=='halfsheetbonus');
  const booked=Object.entries(tickets).filter(([k,v])=>v&&v[nameField]);

  const modeRows=wm.map(modeId=>{
    const m=MODES.find(x=>x.id===modeId);
    const opts=booked.map(([k,v])=>`<option value="${k}" ${_seqWinPicks[gk][modeId]==k?'selected':''}>
      #${p3(parseInt(k))} ${escHtml(v[nameField])}</option>`).join('');
    const anyOpt=`<option value="" ${!_seqWinPicks[gk][modeId]?'selected':''}>No pick (honest random)</option>`;
    return `<div class="fg" style="margin-bottom:8px;">
      <label style="font-size:.72rem;">${m?m.name:modeId}</label>
      <select class="fi" onchange="_seqWinPicks['${gk}']['${modeId}']=this.value?parseInt(this.value):null">
        ${anyOpt}${opts}
      </select>
    </div>`;
  }).join('');

  const hasSeq=g.sequence&&g.sequence.length===90;

  return `
    <div class="adm-card" style="margin-bottom:16px;">
      <div style="font-weight:800;font-size:.95rem;margin-bottom:4px;">${escHtml(g.name)}
        <span style="font-size:.6rem;font-weight:800;padding:2px 8px;border-radius:8px;${badgeStyle}">${isFree?'FREE':'PAID'}</span>
      </div>
      <div style="font-size:.72rem;color:var(--t3);margin-bottom:14px;">${booked.length}/${g.tc||15} tickets booked &middot; ${wm.length} win modes</div>

      ${!booked.length?'<p style="color:var(--t3);font-size:.82rem;">No tickets booked yet wait for more players before generating a sequence.</p>':`
      <div style="font-size:.74rem;font-weight:800;color:var(--t3);letter-spacing:1px;margin-bottom:10px;">STEP 1 PICK WINNERS PER MODE</div>
      ${modeRows}
      <button class="abtn" style="width:100%;margin-bottom:16px;" onclick="seqGenerate('${gk}')">Generate Sequence</button>`}

      <div id="seq-preview-${gk}"></div>

      ${hasSeq?`<div style="background:rgba(0,200,150,.1);border:1.5px solid #00C896;border-radius:10px;padding:10px 12px;font-size:.78rem;color:#00C896;font-weight:700;margin-top:10px;">
        Sequence locked and ready. Live game will use this exact order.
        <button class="bsm bd" style="margin-top:8px;width:100%;" onclick="seqClear('${gk}')">Clear Sequence (revert to random)</button>
      </div>`:''}
    </div>`;
  }catch(e){
    console.error('renderSeqBlock('+gk+') failed:',e);
    toast('Panel error: '+e.message);
    return `<div class="adm-card" style="color:var(--red);font-size:.82rem;">Error loading panel: ${escHtml(e.message)}</div>`;
  }
}

function seqGenerate(gk){
  const g=gk==='gameFree'?GF:G;
  if(!g)return;
  const tickets=g.tickets||{};
  const wm=(g.wm||[]).filter(id=>id!=='fullsheetbonus'&&id!=='halfsheetbonus');

  // Build sequence working backwards from the winner picks
  // All 90 numbers start in a shuffled pool
  const pool=Array.from({length:90},(_,i)=>i+1);
  // Fisher-Yates shuffle for the base order
  for(let i=pool.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[pool[i],pool[j]]=[pool[j],pool[i]];}

  // For each mode with a winner pick, find which numbers that ticket needs
  // and ensure they land at natural positions in the sequence
  const modeTargets=[]; // [{modeId, ticketNum, neededNums, targetCallNum}]
  const naturalCallTargets={early5:18,topline:28,midline:32,botline:28,corners:25,sixcorners:30,pyramid:35,plus:38,diamond:36,fullhouse:72};

  wm.forEach(modeId=>{
    const tn=_seqWinPicks[gk][modeId];
    if(!tn)return;
    const t=tickets[tn];if(!t)return;
    const needed=getNumsForMode(t,modeId);
    if(!needed.length)return;
    modeTargets.push({modeId,tn:parseInt(tn),needed,target:naturalCallTargets[modeId]||50});
  });

  // Sort modes by target call number (earliest mode first)
  modeTargets.sort((a,b)=>a.target-b.target);

  // For each mode, ensure all needed numbers appear before the target call position
  // by swapping them into the correct positions if they aren't already there
  let seq=[...pool];
  modeTargets.forEach(({modeId,needed,target})=>{
    // Find which needed numbers are currently after the target position
    const late=needed.filter(n=>{const idx=seq.indexOf(n);return idx>=target;});
    // Swap each late number with a random number that's before target
    // and isn't needed by another earlier mode's ticket at that position
    late.forEach(n=>{
      // Find a safe swap position before target, not already a needed number for this mode
      const candidates=[];
      for(let i=target-1;i>=0;i--){
        if(!needed.includes(seq[i]))candidates.push(i);
      }
      if(!candidates.length)return; // can't swap, skip
      const swapIdx=candidates[Math.floor(Math.random()*candidates.length)];
      const nIdx=seq.indexOf(n);
      [seq[swapIdx],seq[nIdx]]=[seq[nIdx],seq[swapIdx]];
    });

    // Also ensure the LAST needed number lands AT target (±3) so the win feels natural
    // Find the last needed number in the sequence up to target
    const positions=needed.map(n=>seq.indexOf(n)).filter(i=>i<=target);
    if(positions.length){
      const lastPos=Math.max(...positions);
      // If the win completes too early, push the last number slightly later
      if(lastPos<target-5&&target<90){
        const safeTarget=Math.min(target,88);
        const lastNum=seq[lastPos];
        // Find a spot near target to move it to
        const destIdx=Math.min(safeTarget,seq.length-1);
        seq.splice(lastPos,1);
        seq.splice(destIdx,0,lastNum);
      }
    }
  });

  _seqDraft[gk]=[...seq];
  seqRenderPreview(gk,false);
}

function seqSimulate(gk,seq){
  // Run a silent simulation of the sequence against current tickets
  // Returns array of {modeId, ticketNum, playerName, callNum} winner events
  const g=gk==='gameFree'?GF:G;
  if(!g||!seq||seq.length!==90)return[];
  const tickets=g.tickets||{};
  const nameField=gk==='gameFree'?'username':'name';
  const wm=(g.wm||[]).filter(id=>id!=='fullsheetbonus'&&id!=='halfsheetbonus');
  const called=[];
  const wonModes=new Set();
  const results=[];
  for(let i=0;i<seq.length;i++){
    called.push(seq[i]);
    const cs=new Set(called);
    for(let tn=1;tn<=(g.tc||15);tn++){
      const t=tickets[tn];if(!t)continue;
      wm.forEach(modeId=>{
        if(wonModes.has(modeId))return;
        if(checkMode(t,modeId,cs)){
          wonModes.add(modeId);
          results.push({modeId,tn,playerName:t[nameField]||'Unbooked',callNum:i+1});
        }
      });
    }
    if(wonModes.size===wm.length)break; // all modes won, stop early
  }
  return results;
}

function seqRenderPreview(gk,manualMode){
  const el=document.getElementById('seq-preview-'+gk);if(!el)return;
  const draft=_seqDraft[gk]||[];
  if(!draft.length){el.innerHTML='';return;}

  const results=seqSimulate(gk,draft);
  const winAtCall={};
  results.forEach(r=>{winAtCall[r.callNum]={...r};});

  // Results summary
  const summary=results.map(r=>{
    const m=MODES.find(x=>x.id===r.modeId);
    return `<div style="display:flex;align-items:center;justify-content:space-between;padding:7px 0;border-bottom:1px solid var(--brd);font-size:.8rem;">
      <span>${m?m.name:r.modeId}</span>
      <span style="font-weight:800;">#${p3(r.tn)} <span style="color:var(--t3);font-weight:600;">${escHtml(r.playerName)}</span></span>
      <span style="color:var(--g3);font-weight:800;">Call ${r.callNum}</span>
    </div>`;
  }).join('');

  // Full sequence display — all 90 numbers with winner moments highlighted
  const seqHtml=draft.map((n,i)=>{
    const callNum=i+1;
    const isWin=winAtCall[callNum];
    const m=isWin?MODES.find(x=>x.id===isWin.modeId):null;
    const bg=isWin?'background:var(--g2);color:#fff;':'background:var(--card2);color:var(--t2);';
    const sel=_seqSelected[gk]===i;
    const tapAttr=manualMode?`onclick="seqTap('${gk}',${i})" style="${bg}cursor:pointer;aspect-ratio:1;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:8px;border:1.5px solid ${isWin?'var(--g2)':'var(--brd)'};font-family:Inter,sans-serif;font-size:.7rem;font-weight:800;position:relative;${sel?'box-shadow:0 0 0 3px var(--gold);':''}"`:
      `style="${bg}aspect-ratio:1;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:8px;border:1.5px solid ${isWin?'var(--g2)':'var(--brd)'};font-family:Inter,sans-serif;font-size:.7rem;font-weight:800;position:relative;"`;
    return `<div ${tapAttr}>
      ${n}
      ${isWin?`<span style="font-size:.3rem;font-weight:900;margin-top:1px;opacity:.9;">${m?m.name.split(' ')[0]:''}</span>`:`<span style="font-size:.32rem;color:var(--t3);margin-top:1px;">${callNum}</span>`}
    </div>`;
  }).join('');

  el.innerHTML=`
    <div style="margin-bottom:12px;">
      <div style="font-size:.74rem;font-weight:800;color:var(--t3);letter-spacing:1px;margin-bottom:8px;">STEP 2 REVIEW OUTCOME</div>
      ${summary||'<p style="color:var(--t3);font-size:.8rem;font-style:italic;">No winners detected check if tickets are claimed.</p>'}
    </div>
    <div style="font-size:.74rem;font-weight:800;color:var(--t3);letter-spacing:1px;margin-bottom:8px;">
      FULL SEQUENCE (${manualMode?'TAP TWO NUMBERS TO SWAP':'tap Customise to rearrange'})
    </div>
    <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:5px;margin-bottom:14px;">${seqHtml}</div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      ${!manualMode?`
        <button class="abtn" style="flex:1;" onclick="seqConfirm('${gk}')">Confirm &amp; Lock</button>
        <button class="bsm bw" style="flex:1;" onclick="seqRenderPreview('${gk}',true)">Customise</button>
        <button class="bsm bd" style="flex:1;" onclick="seqGenerate('${gk}')">Regenerate</button>
      `:`
        <button class="abtn" style="flex:1;" onclick="seqConfirm('${gk}')">Confirm &amp; Lock</button>
        <button class="bsm bw" style="flex:1;" onclick="_seqSelected['${gk}']=null;seqRenderPreview('${gk}',false)">← Back</button>
      `}
    </div>
    ${manualMode?'<p style="font-size:.7rem;color:var(--t3);margin-top:8px;text-align:center;">Tap a number to select it (gold ring), then tap another to swap them. Winners update live.</p>':''}`;
}

function seqTap(gk,idx){
  if(_seqSelected[gk]===null){
    _seqSelected[gk]=idx;
  } else {
    if(_seqSelected[gk]!==idx){
      // Swap the two selected positions
      const d=_seqDraft[gk];
      [d[_seqSelected[gk]],d[idx]]=[d[idx],d[_seqSelected[gk]]];
    }
    _seqSelected[gk]=null;
  }
  seqRenderPreview(gk,true);
}

function seqConfirm(gk){
  const draft=_seqDraft[gk];
  if(!draft||draft.length!==90){toast('Generate a sequence first.');return;}
  db.ref(gk+'/sequence').set(draft).then(()=>{
    toast('Sequence locked. Live game will use this exact order.');
    _seqDraft[gk]=[];_seqSelected[gk]=null;
    renderSec();
  }).catch(e=>toast('Error: '+e.message));
}

function seqClear(gk){
  db.ref(gk+'/sequence').remove().then(()=>{
    toast('Sequence cleared. Game will use random calling.');
    renderSec();
  });
}

/* ════ CONFETTI ════ */
function doConfetti(){
  const cv=document.getElementById('cnf');const ctx=cv.getContext('2d');
  cv.style.display='block';cv.width=window.innerWidth;cv.height=window.innerHeight;
  const ps=Array.from({length:110},()=>({x:Math.random()*cv.width,y:Math.random()*-cv.height,r:Math.random()*5+3,d:Math.random()*4+2,c:['#6C47FF','#F4C430','#fff','#9F80FF','#FF4757','#00C896'][Math.floor(Math.random()*6)],ta:0,ti:Math.random()*.07+.04,tilt:0}));
  let fr=0;
  function draw(){ctx.clearRect(0,0,cv.width,cv.height);ps.forEach(p=>{ctx.beginPath();ctx.fillStyle=p.c;ctx.ellipse(p.x+p.tilt,p.y,p.r,p.r*.4,p.ta,0,2*Math.PI);ctx.fill();p.y+=p.d;p.ta+=p.ti;p.tilt=Math.sin(p.ta)*14;if(p.y>cv.height){p.y=-10;p.x=Math.random()*cv.width;}});fr++;if(fr<180)requestAnimationFrame(draw);else cv.style.display='none';}
  draw();
}

