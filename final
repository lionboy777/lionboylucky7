/* ════ TICKET GENERATION PROPER TAMBOLA FORMAT ════
   3 rows × 9 columns. Each row has exactly 5 numbers & 4 blanks.
   Col ranges: col0=1-9, col1=10-19, col2=20-29...col8=80-90
   Each column appears in at least 1 row, max 3 rows.
   Numbers sorted top→bottom within each column. */
function mkN(){
  const used=new Set();
  const rows=[Array(9).fill(null),Array(9).fill(null),Array(9).fill(null)];

  // Distribute 5 active columns per row (15 total across 3 rows from 9 cols)
  // Use a fair distribution: each col appears 1 or 2 times
  const colCounts=Array(9).fill(0);
  const rowActiveCols=[[],[],[]];

  // First pass: assign each column to at least one row
  shuf([0,1,2,3,4,5,6,7,8]).forEach((c,i)=>{
    const ri=i%3;
    rowActiveCols[ri].push(c);
    colCounts[c]++;
  });

  // Second pass: each row needs 5 cols, top up with random
  for(let ri=0;ri<3;ri++){
    while(rowActiveCols[ri].length<5){
      const available=[0,1,2,3,4,5,6,7,8].filter(c=>!rowActiveCols[ri].includes(c)&&colCounts[c]<3);
      if(!available.length)break;
      const c=available[Math.floor(Math.random()*available.length)];
      rowActiveCols[ri].push(c);colCounts[c]++;
    }
    rowActiveCols[ri].sort((a,b)=>a-b);
  }

  // Fill numbers
  for(let ri=0;ri<3;ri++){
    rowActiveCols[ri].forEach(c=>{
      const lo=c===0?1:c*10;
      const hi=c===8?90:c*10+9;
      let n,tries=0;
      do{n=rnd(lo,hi);tries++;}while(used.has(n)&&tries<50);
      used.add(n);rows[ri][c]=n;
    });
  }

  // Sort numbers top→bottom within each column
  for(let c=0;c<9;c++){
    const entries=rows.map((r,ri)=>({ri,val:r[c]})).filter(x=>x.val!==null);
    if(entries.length>1){
      const sortedVals=entries.map(x=>x.val).sort((a,b)=>a-b);
      const sortedRis=entries.map(x=>x.ri).sort((a,b)=>a-b);
      sortedRis.forEach((ri,i)=>rows[ri][c]=sortedVals[i]);
    }
  }
  return rows;
}
function makeTix(tc){
  const o={};
  for(let i=1;i<=tc;i++)o[i]={name:'',nums:mkN(),paid:false};
