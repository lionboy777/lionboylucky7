      if(cdrow)cdrow.innerHTML='<div class="cd-overdue">Ready to start waiting for admin</div>';
      return;
    }
    if(cdrow&&!cdrow.querySelector('#cdh1'))cdrow.innerHTML=CD_NORMAL_HTML;
