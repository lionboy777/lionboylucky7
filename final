      <input type="file" accept="image/*" id="bf-${i}" onchange="handleBannerFile(${i},this)" style="display:block;width:100%;font-size:.74rem;color:var(--t3);margin-bottom:6px;">
      <input class="fi" id="bi-${i}" value="${url}" placeholder="...or paste an image URL">
