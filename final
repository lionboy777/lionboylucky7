  if(diff<=0){hEl.textContent='00';document.getElementById('ev-m').textContent='00';document.getElementById('ev-s').textContent='00';return;}
  hEl.textContent=pad(Math.floor(diff/3600000));document.getElementById('ev-m').textContent=pad(Math.floor((diff%3600000)/60000));document.getElementById('ev-s').textContent=pad(Math.floor((diff%60000)/1000));
  setTimeout(updateEvCD,1000);
}

