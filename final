/* ════ PHYSICAL TICKET BUILDER ════ */
function buildTCard(tn,t,cid,called,highlight){
  const isFree=!!(t&&(t.username!==undefined||t.phone!==undefined));
  const booked=!!(t&&(t.name||t.username));
  const card=document.createElement('div');
  card.className='tcard'+(booked?' booked':' open')+(highlight?' highlighted':'');

  // Coloured band across top looks like a real ticket
  const band=document.createElement('div');band.className='tc-band';
  band.innerHTML='<span class="tc-num num">#'+p3(tn)+'</span><span class="tc-tag">'+(booked?'Booked':'Open')+'</span>';
  card.appendChild(band);

  // Buyer info name+payment for paid tickets, username+phone for free tickets
  if(booked){
    const buyer=document.createElement('div');buyer.className='tc-buyer';
    if(isFree){
      buyer.innerHTML='<span class="tc-name">'+escHtml(t.username||'')+'</span><span class="tc-paid p" style="background:var(--g5);color:var(--g3);">'+escHtml(t.phone||'')+'</span>';
    } else {
      buyer.innerHTML='<span class="tc-name">'+escHtml(t.name||'')+'</span><span class="tc-paid '+(t.paid?'p':'u')+'">'+(t.paid?'Paid':'Pending')+'</span>';
    }
    card.appendChild(buyer);
  }

  // THE PHYSICAL TICKET cream paper, dark grid, green numbers
  const body=document.createElement('div');body.className='tc-body';
  const tbl=document.createElement('table');tbl.className='ticket-tbl';
  const rawNums=t&&t.nums?t.nums:mkN();
  // Firebase omits null slots from arrays, returning holey arrays on read-back.
  // Array.forEach skips holes, so we'd get 5 tds instead of 9.
  // Reconstruct each row as a dense 9-element array with null for blank cells.
  const nums=rawNums.map(row=>{const r=[];for(let c=0;c<9;c++)r.push(row[c]!=null?row[c]:null);return r;});
  nums.forEach((row,ri)=>{
    const tr=document.createElement('tr');
    row.forEach((val,ci)=>{
      const td=document.createElement('td');
      const cell=document.createElement('div');
      if(!val){
        cell.className='tc e';
      } else {
        const marked=called&&called.has(val);
        cell.className='tc h'+(marked?' m':'');
        cell.textContent=val;
        cell.id='tc-'+cid+'-'+tn+'-'+ri+'-'+ci;
      }
      td.appendChild(cell);tr.appendChild(td);
    });
    tbl.appendChild(tr);
  });
  body.appendChild(tbl);card.appendChild(body);
  return card;
}

