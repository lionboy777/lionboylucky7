let _seqDraft={game:[],gameFree:[]};       // working copy of the 90-number sequence being built, per game
let _seqSelected={game:null,gameFree:null};// index of tapped number in manual mode (for tap-to-swap), per game
let _seqWinPicks={game:{},gameFree:{}};    // admin's winner selections per game: {modeId: ticketNumber}

function chkSec(v){
